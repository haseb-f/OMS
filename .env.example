# ==============================================================
# Mercury System — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ==============================================================

# --------------------------------------------------------------
# Database (Prisma)
# --------------------------------------------------------------
# Pooled connection used by the application at runtime
DATABASE_URL="postgresql://user:password@localhost:5432/mercury?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate
DIRECT_URL="postgresql://user:password@localhost:5432/mercury?schema=public"

# --------------------------------------------------------------
# Auth / JWT
# --------------------------------------------------------------
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"

# --------------------------------------------------------------
# Supabase (server-side)
# --------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

# --------------------------------------------------------------
# Supabase (client-side / Next.js public)
# --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
