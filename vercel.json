{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter api exec prisma generate && pnpm --filter web run build",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  }
}
