// ---------------------------------------------------------------------------
// Analytic Accounting (TASK-025) — Odoo-style Analytic Plans + Analytic
// Accounts, replacing traditional Cost Centers as the org-dimension model
// for this single-company MVP. The existing `CostCenter` table/FKs on
// SalesOrder/PurchaseOrder are left exactly as they are (same "keep the
// infrastructure, remove only the admin surface" rule TASK-024 used for
// Company/Branch) — this is new, parallel architecture, not a rename.
// AnalyticDistributionLine is the generic attachment point every future
// transactional document (Sales Invoice, Purchase Invoice, Expense,
// Journal Entry, ...) uses to carry "one Analytic Account per Analytic
// Plan" without a schema change — adding a new Plan is a data row, never a
// migration, which is what lets future reports (Profit by Project, Revenue
// by Branch, ...) aggregate without a redesign.
// ---------------------------------------------------------------------------

model AnalyticPlan {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  description  String?
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  accounts          AnalyticAccount[]
  distributionLines AnalyticDistributionLine[]

  @@map("analytic_plans")
}

model AnalyticAccount {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  name   String
  active Boolean @default(true)
  notes  String?

  analyticPlanId String       @map("analytic_plan_id") @db.Uuid
  analyticPlan   AnalyticPlan @relation(fields: [analyticPlanId], references: [id])

  /// Unlimited hierarchy (same prepared-only pattern as
  /// Warehouse.parentWarehouseId, ADR-0013): a real self-relation FK, no
  /// depth limit, no cycle detection, no traversal API — the UI shows it as
  /// a flat table with a Parent Account column/select, not a tree widget.
  parentAccountId String?           @map("parent_account_id") @db.Uuid
  parentAccount   AnalyticAccount?  @relation("AnalyticAccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   AnalyticAccount[] @relation("AnalyticAccountHierarchy")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  distributionLines    AnalyticDistributionLine[]
  products             Product[]
  defaultForWarehouses Warehouse[]

  @@map("analytic_accounts")
}

/// The generic attachment point every transactional document uses to carry
/// analytic dimensions — "one Analytic Account from EACH Analytic Plan."
/// `documentType`/`documentId` are a free-form link (same idiom as
/// InventoryMovement.referenceType/referenceId) rather than a real FK,
/// since most of the documents this will attach to don't exist as tables
/// yet.
model AnalyticDistributionLine {
  id String @id @default(uuid()) @db.Uuid

  documentType String @map("document_type")
  documentId   String @map("document_id") @db.Uuid

  analyticPlanId String       @map("analytic_plan_id") @db.Uuid
  analyticPlan   AnalyticPlan @relation(fields: [analyticPlanId], references: [id])

  analyticAccountId String          @map("analytic_account_id") @db.Uuid
  analyticAccount   AnalyticAccount @relation(fields: [analyticAccountId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  /// One account per plan per document — selecting a new account for the
  /// same plan replaces the line, it never adds a second one.
  @@unique([documentType, documentId, analyticPlanId])
  @@index([documentType, documentId])
  @@map("analytic_distribution_lines")
}

// ---------------------------------------------------------------------------
// Universal Numbering Engine (TASK-025) — one reusable service every module
// calls instead of hand-rolling its own Postgres sequence. `template` is
// rendered against {DOC}/{YEAR}/{MONTH}/{DAY}/{SEQ}/{BRANCH}/{WAREHOUSE}/
// {COMPANY}/{FISCAL_YEAR} — changing a business's numbering format is an
// edit to this table's row, never a code change.
// ---------------------------------------------------------------------------

model NumberSeries {
  id String @id @default(uuid()) @db.Uuid

  /// Stable key every generateNumber(documentType) call passes — e.g.
  /// "SALES_ORDER", "SUPPLIER". Not a Prisma enum: new document types must
  /// be addable as data, never a migration.
  documentType String  @unique @map("document_type")
  /// The label an admin sees when configuring this series (e.g. "Sales Order").
  label        String
  /// The {DOC} placeholder's value (e.g. "SO").
  docCode      String  @map("doc_code")
  template     String  @default("{DOC}-{YEAR}-{SEQ}")
  nextNumber   Int     @default(1) @map("next_number")
  padding      Int     @default(6)
  separator    String  @default("-")
  yearReset    Boolean @default(true) @map("year_reset")
  monthReset   Boolean @default(false) @map("month_reset")
  dayReset     Boolean @default(false) @map("day_reset")
  /// The last YYYY / YYYYMM / YYYYMMDD key nextNumber was reset for — lets
  /// generateNumber() detect "the period rolled over" without a cron job.
  lastResetKey String? @map("last_reset_key")
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("number_series")
}

// ---------------------------------------------------------------------------
// Master Data Foundation — reference entities with no business logic of
// their own (Taxes, Customer/Supplier Groups, Cities, Languages). Reuses the
// codebase-wide soft-delete convention (deletedAt = archived) rather than a
// parallel status enum: Active/Archived is simply "deletedAt is null / set".
// MasterDataActivityLog is one shared append-only timeline for all of them
// (entityType + entityId), unlike Product/Supplier/Lead's dedicated *Activity
// tables — those are rich, long-lived business objects; these are flat
// reference lists, so one shared log avoids fifteen near-identical tables.
// ---------------------------------------------------------------------------

model Tax {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  rate        Decimal @db.Decimal(5, 2)
  description String?

  /// TASK-046 (Accounting Posting Engine) — the GL account each posting
  /// provider credits (sales-side VAT Output) or debits (purchase-side VAT
  /// Input) for tax collected/paid under this code. Nullable: a Tax row
  /// with no account configured simply can't be posted yet (the Posting
  /// Engine throws a clear error rather than guessing an account).
  outputAccountId String?         @map("output_account_id") @db.Uuid
  outputAccount   ChartOfAccount? @relation("TaxOutputAccount", fields: [outputAccountId], references: [id])

  inputAccountId String?         @map("input_account_id") @db.Uuid
  inputAccount   ChartOfAccount? @relation("TaxInputAccount", fields: [inputAccountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  salesQuotationItems     SalesQuotationItem[]
  salesOrderDocumentItems SalesOrderDocumentItem[]
  salesInvoiceItems       SalesInvoiceItem[]
  salesReturnItems        SalesReturnItem[]
  purchaseQuotationItems  PurchaseQuotationItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  purchaseInvoiceItems    PurchaseInvoiceItem[]
  purchaseReturnItems     PurchaseReturnItem[]

  @@map("taxes")
}

model CustomerGroup {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  /// Accounting Configuration (TASK-047) — optional group-level overrides;
  /// a Customer's own defaultReceivableAccountId still takes priority over
  /// this (resolved by AccountMappingService).
  defaultReceivableAccountId String?         @map("default_receivable_account_id") @db.Uuid
  defaultReceivableAccount   ChartOfAccount? @relation("CustomerGroupDefaultReceivable", fields: [defaultReceivableAccountId], references: [id])

  defaultRevenueAccountId String?         @map("default_revenue_account_id") @db.Uuid
  defaultRevenueAccount   ChartOfAccount? @relation("CustomerGroupDefaultRevenue", fields: [defaultRevenueAccountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  customers Customer[]

  @@map("customer_groups")
}

model SupplierGroup {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
