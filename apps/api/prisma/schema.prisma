// ---------------------------------------------------------------------------
// Purchasing Document Pipeline (TASK-048) — Quotation -> Order -> Invoice ->
// Return, mirroring the Sales Foundation's proven shape (SalesQuotation/
// SalesInvoice/SalesReturn) field-for-field wherever the concepts overlap.
// PurchaseOrder itself (ADR-0015, above) keeps its own schema/status/
// endpoints exactly as shipped — it is only linked to, never redesigned:
// PurchaseQuotation gains a "Convert to Order" action that creates a
// PurchaseOrder through the existing PurchaseOrdersService, and PurchaseOrder
// gains a "Convert to Invoice" (Goods Receipt) action the same way. Totals
// on all three new documents are server-computed (never caller-supplied),
// per this task's explicit "Use backend calculations only" — a deliberate
// departure from PurchaseOrderItem.subtotal's caller-supplied convention,
// same reasoning as SalesQuotation.subtotal's schema comment. Only
// Invoice/Return carry a `warehouseId` per line (required, enforced in each
// service, same "conditionally required" pattern SalesLineItemInputDto
// uses) — Quotation and PurchaseOrder have none, matching the existing
// PurchaseOrderItem shape; a warehouse is only meaningful once goods
// actually move. Goods Receipt = Purchase Invoice confirm (increases
// Inventory via InventoryService.postPurchaseReceipt); Purchase Return
// confirm decreases it via postPurchaseReturn — see inventory.service.ts.
// ---------------------------------------------------------------------------

/// Shared status vocabulary across the three new Purchasing documents.
/// Mirrors SalesDocumentStatus minus PARTIALLY_DELIVERED/DELIVERED (no
/// partial-receipt tracking exists on PurchaseOrderItem to roll up against).
enum PurchaseDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CONFIRMED
  CANCELLED
  CLOSED
}

