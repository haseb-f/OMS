// ---------------------------------------------------------------------------
// Analytic Accounting (TASK-025) — Odoo-style Analytic Plans + Analytic
// Accounts, replacing traditional Cost Centers as the org-dimension model
// for this single-company MVP. The existing `CostCenter` table/FKs on
// SalesOrder/PurchaseOrder are left exactly as they are (same "keep the
// infrastructure, remove only the admin surface" rule TASK-024 used for
// Company/Branch) — this is new, parallel architecture, not a rename.
// AnalyticDistributionLine is the generic attachment point every future
// transactional document (Sales Invoice, Purchase Invoice, Expense,
// Journal Entry, ...) uses to carry "one Analytic Account per Analytic
// Plan" without a schema change — adding a new Plan is a data row, never a
// migration, which is what lets future reports (Profit by Project, Revenue
// by Branch, ...) aggregate without a redesign.
// ---------------------------------------------------------------------------

model AnalyticPlan {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  description  String?
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  accounts          AnalyticAccount[]
  distributionLines AnalyticDistributionLine[]

  @@map("analytic_plans")
}

model AnalyticAccount {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  name   String
  active Boolean @default(true)
  notes  String?

  analyticPlanId String       @map("analytic_plan_id") @db.Uuid
  analyticPlan   AnalyticPlan @relation(fields: [analyticPlanId], references: [id])

  /// Unlimited hierarchy (same prepared-only pattern as
  /// Warehouse.parentWarehouseId, ADR-0013): a real self-relation FK, no
  /// depth limit, no cycle detection, no traversal API — the UI shows it as
  /// a flat table with a Parent Account column/select, not a tree widget.
  parentAccountId String?           @map("parent_account_id") @db.Uuid
  parentAccount   AnalyticAccount?  @relation("AnalyticAccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   AnalyticAccount[] @relation("AnalyticAccountHierarchy")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  distributionLines    AnalyticDistributionLine[]
  products             Product[]
  defaultForWarehouses Warehouse[]

  @@map("analytic_accounts")
}

/// The generic attachment point every transactional document uses to carry
/// analytic dimensions — "one Analytic Account from EACH Analytic Plan."
/// `documentType`/`documentId` are a free-form link (same idiom as
/// InventoryMovement.referenceType/referenceId) rather than a real FK,
/// since most of the documents this will attach to don't exist as tables
/// yet.
model AnalyticDistributionLine {
  id String @id @default(uuid()) @db.Uuid

  documentType String @map("document_type")
  documentId   String @map("document_id") @db.Uuid

  analyticPlanId String       @map("analytic_plan_id") @db.Uuid
  analyticPlan   AnalyticPlan @relation(fields: [analyticPlanId], references: [id])

  analyticAccountId String          @map("analytic_account_id") @db.Uuid
  analyticAccount   AnalyticAccount @relation(fields: [analyticAccountId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  /// One account per plan per document — selecting a new account for the
  /// same plan replaces the line, it never adds a second one.
  @@unique([documentType, documentId, analyticPlanId])
  @@index([documentType, documentId])
  @@map("analytic_distribution_lines")
}

// ---------------------------------------------------------------------------
// Universal Numbering Engine (TASK-025) — one reusable service every module
// calls instead of hand-rolling its own Postgres sequence. `template` is
// rendered against {DOC}/{YEAR}/{MONTH}/{DAY}/{SEQ}/{BRANCH}/{WAREHOUSE}/
// {COMPANY}/{FISCAL_YEAR} — changing a business's numbering format is an
// edit to this table's row, never a code change.
// ---------------------------------------------------------------------------

model NumberSeries {
  id String @id @default(uuid()) @db.Uuid

  /// Stable key every generateNumber(documentType) call passes — e.g.
  /// "SALES_ORDER", "SUPPLIER". Not a Prisma enum: new document types must
  /// be addable as data, never a migration.
  documentType String  @unique @map("document_type")
  /// The label an admin sees when configuring this series (e.g. "Sales Order").
  label        String
  /// The {DOC} placeholder's value (e.g. "SO").
  docCode      String  @map("doc_code")
  template     String  @default("{DOC}-{YEAR}-{SEQ}")
  nextNumber   Int     @default(1) @map("next_number")
  padding      Int     @default(6)
  separator    String  @default("-")
  yearReset    Boolean @default(true) @map("year_reset")
  monthReset   Boolean @default(false) @map("month_reset")
  dayReset     Boolean @default(false) @map("day_reset")
  /// The last YYYY / YYYYMM / YYYYMMDD key nextNumber was reset for — lets
  /// generateNumber() detect "the period rolled over" without a cron job.
  lastResetKey String? @map("last_reset_key")
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("number_series")
}

// ---------------------------------------------------------------------------
// Master Data Foundation — reference entities with no business logic of
// their own (Taxes, Customer/Supplier Groups, Cities, Languages). Reuses the
// codebase-wide soft-delete convention (deletedAt = archived) rather than a
// parallel status enum: Active/Archived is simply "deletedAt is null / set".
// MasterDataActivityLog is one shared append-only timeline for all of them
// (entityType + entityId), unlike Product/Supplier/Lead's dedicated *Activity
// tables — those are rich, long-lived business objects; these are flat
// reference lists, so one shared log avoids fifteen near-identical tables.
// ---------------------------------------------------------------------------

model Tax {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  rate        Decimal @db.Decimal(5, 2)
  description String?

  /// TASK-046 (Accounting Posting Engine) — the GL account each posting
  /// provider credits (sales-side VAT Output) or debits (purchase-side VAT
  /// Input) for tax collected/paid under this code. Nullable: a Tax row
  /// with no account configured simply can't be posted yet (the Posting
  /// Engine throws a clear error rather than guessing an account).
  outputAccountId String?         @map("output_account_id") @db.Uuid
  outputAccount   ChartOfAccount? @relation("TaxOutputAccount", fields: [outputAccountId], references: [id])

  inputAccountId String?         @map("input_account_id") @db.Uuid
  inputAccount   ChartOfAccount? @relation("TaxInputAccount", fields: [inputAccountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  salesQuotationItems     SalesQuotationItem[]
  salesOrderDocumentItems SalesOrderDocumentItem[]
  salesInvoiceItems       SalesInvoiceItem[]
  salesReturnItems        SalesReturnItem[]
  purchaseQuotationItems  PurchaseQuotationItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  purchaseInvoiceItems    PurchaseInvoiceItem[]
  purchaseReturnItems     PurchaseReturnItem[]

  @@map("taxes")
}

model CustomerGroup {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  /// Accounting Configuration (TASK-047) — optional group-level overrides;
  /// a Customer's own defaultReceivableAccountId still takes priority over
  /// this (resolved by AccountMappingService).
  defaultReceivableAccountId String?         @map("default_receivable_account_id") @db.Uuid
  defaultReceivableAccount   ChartOfAccount? @relation("CustomerGroupDefaultReceivable", fields: [defaultReceivableAccountId], references: [id])

  defaultRevenueAccountId String?         @map("default_revenue_account_id") @db.Uuid
  defaultRevenueAccount   ChartOfAccount? @relation("CustomerGroupDefaultRevenue", fields: [defaultRevenueAccountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  customerProfiles CustomerProfile[]

  @@map("customer_groups")
}

model SupplierGroup {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  /// Accounting Configuration (TASK-047) — optional group-level overrides;
  /// a Supplier's own defaultPayableAccountId still takes priority over
  /// this (resolved by AccountMappingService).
  defaultPayableAccountId String?         @map("default_payable_account_id") @db.Uuid
  defaultPayableAccount   ChartOfAccount? @relation("SupplierGroupDefaultPayable", fields: [defaultPayableAccountId], references: [id])

  defaultPurchaseAccountId String?         @map("default_purchase_account_id") @db.Uuid
  defaultPurchaseAccount   ChartOfAccount? @relation("SupplierGroupDefaultPurchase", fields: [defaultPurchaseAccountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  supplierProfiles SupplierProfile[]

  @@map("supplier_groups")
}

model City {
  id   String @id @default(uuid()) @db.Uuid
  code String
  name String

  countryId String  @map("country_id") @db.Uuid
  country   Country @relation(fields: [countryId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@unique([countryId, code])
  @@map("cities")
}

/// Closed set — text direction has exactly two values.
enum TextDirection {
  LTR
  RTL
}

model Language {
  id         String        @id @default(uuid()) @db.Uuid
  code       String        @unique
  name       String
  nativeName String?       @map("native_name")
  direction  TextDirection @default(LTR)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("languages")
}

/// Append-only ledger (same exception as InventoryMovement/SalesOrderStatusHistory
/// — no updatedAt/updatedBy/deletedAt) shared across every Master Data entity.
/// `entityType` is a plain string ("WAREHOUSE", "TAX", ...), not an enum — new
/// master data modules can log to this without a migration.
model MasterDataActivityLog {
  id String @id @default(uuid()) @db.Uuid

  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid

  type        String
  description String
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@index([entityType, entityId])
  @@map("master_data_activity_logs")
}

// ---------------------------------------------------------------------------
// Transaction Types Registry (Cash Transactions Foundation) — answers "why
// did the money move," never "how" (Payment Method — `PaymentSource`),
// "where it landed" (Financial Account — `ReceivingAccount`/
// `ChartOfAccount`), or "where the record came from" (Source — a future
// Cash Transaction's own `ImportJob`/manual-entry origin). Those stay
// separate dimensions and this registry never merges them in.
//
// This is a NEW, broader catalog for the upcoming Cash Transactions/Google
// Sheets Sync/Reconciliation phases — it does not replace or migrate
// `FinancialTransactionType` (CUSTOMER_RECEIPT/SUPPLIER_PAYMENT/
// EXPENSE_PAYMENT, the closed accounting-voucher-type enum
// `FinancialTransactionsService`'s posting logic already keys off) or
// `CashFlowOutgoingType` (SUPPLIER_PAYMENT/EXPENSE, the narrower hint
// `BankTransaction`/`CashFlowReconciliationService` already use) — both
// keep working completely untouched. A future Cash Transaction model can
// carry a `transactionTypeId` FK to this table alongside (not instead of)
// those existing fields once the next-phase Reconciliation Engine is built.
// ---------------------------------------------------------------------------

/// A type's direction is fixed — never chosen freely per-transaction.
enum TransactionDirection {
  IN
  OUT
}

/// STANDARD is a normal, potentially revenue/expense-bearing cash movement;
/// TRANSFER marks the two Internal Transfer system types as two sides of
/// one internal account-to-account movement — structurally excluded from
/// revenue/expense reporting by this flag, rather than relying on every
/// future report to remember to filter certain codes out.
enum TransactionNature {
  STANDARD
  TRANSFER
}

/// Lightweight default-accounting-treatment HINT a future Posting/
/// Reconciliation engine may read — never itself a posting rule (Account
/// Mapping + the Posting Providers stay the only place an actual Chart of
/// Account id gets resolved). Exists to make "not every IN is Revenue, not
/// every OUT is Expense" a structural fact on the type rather than tribal
/// knowledge — e.g. FINANCING_RECEIVED/OWNER_CONTRIBUTION/
/// INVESTMENT_RECEIVED/INTERNAL_TRANSFER_IN are never OPERATING_REVENUE;
/// FINANCING_REPAYMENT/PROFIT_DISTRIBUTION/INTERNAL_TRANSFER_OUT are never
/// OPERATING_EXPENSE.
enum TransactionAccountingTreatment {
  OPERATING_REVENUE
  OPERATING_EXPENSE
  EQUITY_MOVEMENT
  LIABILITY_MOVEMENT
  TRANSFER
  NEUTRAL
}

/// What kind of object the future Reconciliation Engine should attempt to
/// match a transaction of this type against. Normalized to one closed,
/// generic set rather than one enum value per document type this system
/// already has (SalesOrder/SalesInvoice/Payment/...) — a system type whose
/// natural target is more specific than this set (e.g. a vendor refund
/// against a specific Purchase Invoice) still starts from the closest
/// generic bucket (`VENDOR`) here; the engine narrows further using the
/// transaction's own reference/description, exactly like
/// `CashFlowReconciliationService.suggestIncoming`/`suggestOutgoing`
/// already narrow `PAYMENT`/`STORE_ORDER`/`SALES_INVOICE`/
/// `PURCHASE_INVOICE` candidates today.
enum TransactionMatchingTarget {
  STORE_ORDER
  SALES_INVOICE
  PURCHASE_INVOICE
  CUSTOMER
  VENDOR
  EMPLOYEE
  FINANCIAL_ACCOUNT
  EXPENSE_ACCOUNT
  LIABILITY
  EQUITY_OR_PARTNER
  INVESTMENT
  ACCOUNT
}

/// System rows (`isSystem = true`) are seeded once (migration + idempotent
/// `prisma/seed.ts` upsert by `code`, same dual pattern as
/// `ShippingStatus`) and never destructively editable — the service layer
/// rejects changes to `code`/`direction`/`nature`/`matchingTarget` and
/// blocks `archive()` outright once `isSystem` is true; `isActive`/
/// `defaultAccountId`/`defaultAccountingTreatment`/`sortOrder` stay safely
/// configurable. Admins may additionally create Custom types (`isSystem =
/// false`) with a system-generated `code` — never hand-typed, same
/// `USR_<random>` convention `ShippingStatusesService.create` already uses.
model TransactionType {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  nameAr String  @map("name_ar")
  nameEn String? @map("name_en")

  direction TransactionDirection
  nature    TransactionNature    @default(STANDARD)

  matchingTarget TransactionMatchingTarget? @map("matching_target")

  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")

  defaultAccountingTreatment TransactionAccountingTreatment @default(NEUTRAL) @map("default_accounting_treatment")

  defaultAccountId String?         @map("default_account_id") @db.Uuid
  defaultAccount   ChartOfAccount? @relation("TransactionTypeDefaultAccount", fields: [defaultAccountId], references: [id])

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([direction, isActive])
  @@map("transaction_types")
}

// ---------------------------------------------------------------------------
// Financial Transactions & Matching Engine (TASK-043) — NOT the Accounting
// Engine (TASK-044): no journal entries, no General Ledger, no Chart of
// Accounts logic live here. This is the settlement layer the Accounting
// Engine will later consume — Customer Receipt and Supplier Payment are the
// same shape (party + date + how-paid + amount + reference + notes +
// allocations), so they share ONE model pair (discriminated by `type`)
// rather than duplicating a second near-identical table pair the way
// Sales/Purchasing intentionally do mirror each other with separate tables
// — those are full multi-status documents with different line-item shapes;
// a receipt and a payment are the same record with the money flowing the
// other way, so unifying them is the non-duplicative choice here, not a
// deviation from precedent.
//
// Invoice payment status is NEVER stored on SalesInvoice/PurchaseInvoice —
// always derived by summing `FinancialTransactionAllocation` rows for
// CONFIRMED transactions against that invoice (see
// financial-transactions/shared/invoice-payment.util.ts). This guarantees
// "never allow manual editing" by construction: there is no column to edit.
//
// Reuses existing reference data rather than re-inventing it: `PaymentSource`
// (how paid) and `ReceivingAccount` (where it landed) already exist for the
// COD `Payment` model — both are genuinely party-agnostic, so they are
// reused as-is here, not duplicated.
// ---------------------------------------------------------------------------

enum FinancialTransactionType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  /// Cash Flow module — an outgoing transaction classified as an Expense
  /// (never a Supplier Payment): debits `expenseAccountId` directly instead
  /// of resolving Accounts Payable via AccountMappingService, and
  /// `supplierId`/`customerId` both stay null. Reuses this exact model/
  /// service/Confirm-posts workflow — never a second "Expense Journal".
  EXPENSE_PAYMENT
}

/// Deliberately minimal — no Submit/Approve step was requested for
/// Receipts/Payments (unlike Sales/Purchasing documents). Draft is fully
/// editable (including allocations, which don't count toward invoice
/// payment status yet); Confirm locks the header and makes its allocations
/// "real" (invoice status recomputed); Cancel reverses a Confirmed
/// transaction (unallocates, invoice status recomputed again).
enum FinancialTransactionStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model FinancialTransaction {
  id                String                   @id @default(uuid()) @db.Uuid
  transactionNumber String                   @unique @map("transaction_number")
  type              FinancialTransactionType

  /// Required for CUSTOMER_RECEIPT/SUPPLIER_PAYMENT, always null for
  /// EXPENSE_PAYMENT (no party — see expenseAccountId below). Formerly a
  /// split customerId/supplierId pair; unified since a Partner's role
  /// already disambiguates which side of the transaction this is.
  partnerId String?  @map("partner_id") @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  /// Only set when `type = EXPENSE_PAYMENT` — the account debited directly
  /// (Marketing Expense, ...) instead of resolving Accounts Payable.
  expenseAccountId String?         @map("expense_account_id") @db.Uuid
  expenseAccount   ChartOfAccount? @relation("FinancialTransactionExpenseAccount", fields: [expenseAccountId], references: [id])

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  /// TASK-051 Document Context Enrichment — see SalesInvoice.companyId.
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  transactionDate DateTime @default(now()) @map("transaction_date")

  /// "How paid" (Cash, Bank Transfer, Visa...) — reuses the existing
  /// PaymentSource table (built for the COD Payment flow, genuinely
  /// party-agnostic) rather than the legacy, still-unimplemented
  /// PaymentMethod placeholder entity.
  paymentSourceId String?        @map("payment_source_id") @db.Uuid
  paymentSource   PaymentSource? @relation(fields: [paymentSourceId], references: [id])

  /// "Where the money landed" — nullable placeholder, not shown in the
  /// default editor view (More Details only), prepared for TASK-044 the
  /// same way PurchaseOrder's "Preparation For Future" columns were
  /// (ADR-0015): no extra business logic attached to it here.
  receivingAccountId String?           @map("receiving_account_id") @db.Uuid
  receivingAccount   ReceivingAccount? @relation(fields: [receivingAccountId], references: [id])

  amount Decimal @db.Decimal(12, 2)

  referenceNumber String? @map("reference_number")
  notes           String?

  status FinancialTransactionStatus @default(DRAFT)

  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by") @db.Uuid

  /// Prep-for-future (TASK-044) — never set true by this task's code, same
  /// treatment as SalesInvoice/PurchaseInvoice.postedToAccounting.
  postedToAccounting Boolean   @default(false) @map("posted_to_accounting")
  accountingPostedAt DateTime? @map("accounting_posted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  allocations               FinancialTransactionAllocation[]
  activities                FinancialTransactionActivity[]
  /// Cash Flow module — the Bank/Cash Flow Transaction(s) this voucher was
  /// generated/matched from, if any (never set for a manually-created
  /// voucher). Traceability back to the original imported row.
  matchedByBankTransactions BankTransaction[]

  @@map("financial_transactions")
}

/// "One receipt/payment may settle one or many invoices; one invoice may be
/// settled by many receipts/payments" — the join table for the matching
/// engine. Exactly one of `salesInvoiceId`/`purchaseInvoiceId` is populated,
/// matching the parent transaction's `type` (validated in the service
/// layer — the same "closed set, conditionally required" pattern
/// SalesLineItemInputDto already uses for warehouseId). Hard-deleted on
/// "Unallocate" — allocations aren't specified as an append-only ledger
/// (unlike InventoryMovement, ADR-0013); the parent transaction's own
/// Activity timeline preserves the "what happened" audit trail.
model FinancialTransactionAllocation {
  id String @id @default(uuid()) @db.Uuid

  transactionId String               @map("transaction_id") @db.Uuid
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id])

  salesInvoiceId String?       @map("sales_invoice_id") @db.Uuid
  salesInvoice   SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])

  purchaseInvoiceId String?          @map("purchase_invoice_id") @db.Uuid
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(12, 2)
  allocationDate  DateTime @default(now()) @map("allocation_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("financial_transaction_allocations")
}

/// Timeline — same shape as every other *Activity entity in this codebase.
model FinancialTransactionActivity {
  id String @id @default(uuid()) @db.Uuid

  transactionId String               @map("transaction_id") @db.Uuid
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("financial_transaction_activities")
}

/// Accounting Foundation (TASK-044 Part 6) — infrastructure only, no
/// mappings: nothing in Sales/Purchasing/Financial Transactions creates a
/// JournalEntry automatically yet. Draft is fully editable; Posted is
/// immutable and part of the ledger; Reversed is terminal — set on the
/// ORIGINAL entry once its counter-entry (debits/credits swapped) is
/// created, which itself posts immediately as a normal Posted entry linked
/// back via reversalOfEntryId. Mirrors FinancialTransactionStatus in having
/// no Submit/Approve step.
enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id          String             @id @default(uuid()) @db.Uuid
  entryNumber String             @unique @map("entry_number")
  /// Doubles as "Posting Date" — the ledger date this entry belongs to.
  entryDate   DateTime           @default(now()) @map("entry_date")
  description String?
  status      JournalEntryStatus @default(DRAFT)

  /// Server-computed from `lines` at create/update time — never trusted
  /// from the client, same convention as SalesInvoice's totals.
  totalDebit  Decimal @default(0) @map("total_debit") @db.Decimal(14, 2)
  totalCredit Decimal @default(0) @map("total_credit") @db.Decimal(14, 2)

  /// Posting Engine / Posting Providers (TASK-046) — which provider/source
  /// document created this entry. Free-text + nullable id, not a real FK,
  /// since the source can be any document table (Sales Invoice, Purchase
  /// Invoice, Financial Transaction, Inventory Movement, ...). Manual
  /// entries created through the Journal Entries UI use sourceType=MANUAL.
  sourceType String? @map("source_type")
  sourceId   String? @map("source_id") @db.Uuid

  /// The originating document's own number (e.g. SalesInvoice.invoiceNumber)
  /// — display/audit convenience only, never used for lookups.
  referenceNumber String? @map("reference_number")

  /// TASK-046 Journal Entry Structure — Company/Branch/Currency are real
  /// FKs (those models already exist); Project/CostCenter are real FKs too
  /// but nothing populates them yet (no document carries a project/cost
  /// center today — same "prepared, not wired" pattern as
  /// ChartOfAccount.parentAccountId). InvestorBatch has no model at all
  /// (Investor Accounting is explicitly out of scope), so it stays a bare
  /// placeholder id, same treatment as Supplier.defaultExpenseAccountId
  /// before this task.
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  /// TASK-053 — which Journal (Sales/Purchase/Cash/Bank/General) this entry
  /// belongs to. Nullable so every entry the Posting Engine already created
  /// keeps working unchanged; `JournalEntriesService.post()` requires it for
  /// entries created from here on ("no posting without a Journal").
  journalId String?  @map("journal_id") @db.Uuid
  journal   Journal? @relation(fields: [journalId], references: [id])

  /// TASK-055 — "every accounting document must belong to a Fiscal Year."
  /// Auto-resolved from `entryDate` by the Posting Engine and
  /// `JournalEntriesService`, the same way `journalId`/period-open checks
  /// already resolve by date — never a field the caller sets directly.
  /// Nullable so entries dated outside any configured Fiscal Year (or
  /// created before this task) keep working unchanged.
  fiscalYearId String?     @map("fiscal_year_id") @db.Uuid
  fiscalYear   FiscalYear? @relation(fields: [fiscalYearId], references: [id])

  investorBatchId String? @map("investor_batch_id") @db.Uuid

  /// Self-relation: the reversing entry points back at the entry it
  /// reverses. One reversing entry per original (hence @unique).
  reversalOfEntryId String?       @unique @map("reversal_of_entry_id") @db.Uuid
  reversalOfEntry   JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry   JournalEntry? @relation("JournalEntryReversal")

  postedAt   DateTime? @map("posted_at")
  postedBy   String?   @map("posted_by") @db.Uuid
  reversedAt DateTime? @map("reversed_at")
  reversedBy String?   @map("reversed_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  lines      JournalEntryLine[]
  activities JournalEntryActivity[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id String @id @default(uuid()) @db.Uuid

  journalEntryId String       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String         @map("account_id") @db.Uuid
  account   ChartOfAccount @relation(fields: [accountId], references: [id])

  /// Unified Partner Architecture (subledger dimension) — required exactly
  /// when `account.partnerControlType` is set (enforced in
  /// JournalEntriesService.resolveLines() for manual entries and
  /// PostingEngineService.assertPartnersRequired() for automatic postings),
  /// null on every other line (Revenue/COGS/Inventory/VAT/... never carry a
  /// partner). This is what makes the Partner Ledger directly queryable —
  /// no more per-sourceType join back to SalesInvoice/PurchaseInvoice/etc.
  partnerId String?  @map("partner_id") @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  /// TASK-053 — per-line cost attribution (the Journal Lines Grid's Cost
  /// Center / Project columns), distinct from `JournalEntry.costCenterId`/
  /// `projectId` above (header-level, still unpopulated by any provider):
  /// a manual entry can debit one cost center and credit another on the
  /// same entry, so this lives on the line, not the header.
  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  description String?
  debit       Decimal @default(0) @db.Decimal(14, 2)
  credit      Decimal @default(0) @db.Decimal(14, 2)
  lineOrder   Int     @default(0) @map("line_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId])
  @@index([partnerId])
  @@index([accountId, partnerId])
  @@map("journal_entry_lines")
}

/// Timeline — same shape as every other *Activity entity in this codebase.
model JournalEntryActivity {
  id String @id @default(uuid()) @db.Uuid

  journalEntryId String       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("journal_entry_activities")
}

/// TASK-058 — "Recurring Journal Templates": a saved starting point for a
/// new Manual Journal Entry (Journal + description pattern + line
/// structure), applied via "New from Template". `lines` stores the same
/// shape the editor's grid already works with (accountId/description/
/// costCenterId/projectId/debit/credit) as JSON — mirrors
/// `ImportMappingTemplate.columnMapping`'s own "template payload as JSON"
/// choice. Deliberately NOT a scheduler: creating an entry from a template
/// is a manual action every time, the same "prepare architecture, don't
/// implement scheduler" boundary already used for ImportJob.scheduleConfig.
model JournalEntryTemplate {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?

  journalId String?  @map("journal_id") @db.Uuid
  journal   Journal? @relation(fields: [journalId], references: [id])

  lines Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@map("journal_entry_templates")
}

/// TASK-051 Phase 2 — Fiscal Years & Accounting Periods. A closed set of two
/// statuses: OPEN (default) and CLOSED (reopenable back to OPEN by an
/// Administrator). Company-scoped but nullable, same "prepared, ambient"
/// treatment as every other companyId this task added — a single-company
/// deployment can leave it unset.
enum FiscalYearStatus {
  OPEN
  CLOSED
}

/// Three states, not two: OPEN (postable) -> CLOSED (blocks posting,
/// reversible) -> LOCKED (blocks posting, permanent — only reachable from
/// CLOSED, never reopened). The Posting Engine checks this status for every
/// Journal Entry it creates (see PostingEngineService.assertPeriodOpen).
enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model FiscalYear {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  status    FiscalYearStatus @default(OPEN)

  /// TASK-055 — the year new documents' auto-resolved fiscalYearId falls
  /// back to display as "the current year" in the UI; not enforced at the
  /// database level (only one row should be true at a time — the service
  /// layer clears any prior default when setting a new one, same pattern
  /// as ReceivingAccount/PaymentSource "default" flags elsewhere).
  isDefault Boolean @default(false) @map("is_default")

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  periods        AccountingPeriod[]
  journalEntries JournalEntry[]

  @@map("fiscal_years")
}

/// Auto-generated as 12 monthly periods when its FiscalYear is created —
/// never created one at a time by a user, matching how this codebase
/// prefers system-generated document numbers over manual entry (UX Policy).
model AccountingPeriod {
  id        String                 @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime               @map("start_date")
  endDate   DateTime               @map("end_date")
  status    AccountingPeriodStatus @default(OPEN)

  fiscalYearId String     @map("fiscal_year_id") @db.Uuid
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])

  closedAt DateTime? @map("closed_at")
  closedBy String?   @map("closed_by") @db.Uuid
  lockedAt DateTime? @map("locked_at")
  lockedBy String?   @map("locked_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("accounting_periods")
}

/// Accounting Posting Engine (TASK-046) — the global fallback Chart of
/// Accounts a Posting Provider uses when a more specific source (Customer/
/// Supplier/Tax's own account fields) has none configured. Deliberately a
/// singleton (one row, no company/branch scoping) since no document carries
/// a companyId/branchId today — same simplification every other
/// not-yet-multi-entity setting in this codebase makes. No admin UI is
/// built for this in TASK-046 (out of scope) — configure via the API.
model PostingSettings {
  id String @id @default(uuid()) @db.Uuid

  salesRevenueAccountId String?         @map("sales_revenue_account_id") @db.Uuid
  salesRevenueAccount   ChartOfAccount? @relation("PostingSalesRevenue", fields: [salesRevenueAccountId], references: [id])

  costOfGoodsSoldAccountId String?         @map("cogs_account_id") @db.Uuid
  costOfGoodsSoldAccount   ChartOfAccount? @relation("PostingCogs", fields: [costOfGoodsSoldAccountId], references: [id])

  inventoryAccountId String?         @map("inventory_account_id") @db.Uuid
  inventoryAccount   ChartOfAccount? @relation("PostingInventory", fields: [inventoryAccountId], references: [id])

  accountsReceivableAccountId String?         @map("ar_account_id") @db.Uuid
  accountsReceivableAccount   ChartOfAccount? @relation("PostingAr", fields: [accountsReceivableAccountId], references: [id])

  accountsPayableAccountId String?         @map("ap_account_id") @db.Uuid
  accountsPayableAccount   ChartOfAccount? @relation("PostingAp", fields: [accountsPayableAccountId], references: [id])

  /// Fallback for non-inventory-tracked Purchase Invoice lines when the
  /// Supplier has no defaultExpenseAccountId of its own.
  defaultExpenseAccountId String?         @map("default_expense_account_id") @db.Uuid
  defaultExpenseAccount   ChartOfAccount? @relation("PostingExpense", fields: [defaultExpenseAccountId], references: [id])

  /// TASK-047 — completes the Accounting Settings surface. Several of
  /// these (Sales Discount/Return, Purchase Return, Cash, Bank, Round
  /// Difference) are stored and exposed for configuration but have no
  /// consumer in the Posting Engine yet — wiring them in would mean
  /// posting a new/different journal line, which this task's "do not
  /// change posting rules" constraint explicitly forbids. They're
  /// prepared infrastructure, same pattern as every other
  /// not-yet-wired-but-real column in this codebase.
  salesDiscountAccountId String?         @map("sales_discount_account_id") @db.Uuid
  salesDiscountAccount   ChartOfAccount? @relation("PostingSalesDiscount", fields: [salesDiscountAccountId], references: [id])

  salesReturnAccountId String?         @map("sales_return_account_id") @db.Uuid
  salesReturnAccount   ChartOfAccount? @relation("PostingSalesReturn", fields: [salesReturnAccountId], references: [id])

  /// Wired: InventoryAdjustmentPostingProvider's offsetting line (was
  /// hardcoded to costOfGoodsSoldAccountId in TASK-046).
  inventoryAdjustmentAccountId String?         @map("inventory_adjustment_account_id") @db.Uuid
  inventoryAdjustmentAccount   ChartOfAccount? @relation("PostingInventoryAdjustment", fields: [inventoryAdjustmentAccountId], references: [id])

  /// Wired: the fallback tier ahead of defaultExpenseAccountId for
  /// non-inventory Purchase Invoice lines once Category/SupplierGroup have
  /// no override either.
  purchaseAccountId String?         @map("purchase_account_id") @db.Uuid
  purchaseAccount   ChartOfAccount? @relation("PostingPurchase", fields: [purchaseAccountId], references: [id])

  purchaseReturnAccountId String?         @map("purchase_return_account_id") @db.Uuid
  purchaseReturnAccount   ChartOfAccount? @relation("PostingPurchaseReturn", fields: [purchaseReturnAccountId], references: [id])

  cashAccountId String?         @map("cash_account_id") @db.Uuid
  cashAccount   ChartOfAccount? @relation("PostingCash", fields: [cashAccountId], references: [id])

  bankAccountId String?         @map("bank_account_id") @db.Uuid
  bankAccount   ChartOfAccount? @relation("PostingBank", fields: [bankAccountId], references: [id])

  /// Wired: fallback used only when a specific Tax record has no
  /// outputAccountId/inputAccountId of its own — Tax is always checked
  /// first (never hardcoded, per this task's explicit instruction).
  vatOutputAccountId String?         @map("vat_output_account_id") @db.Uuid
  vatOutputAccount   ChartOfAccount? @relation("PostingVatOutput", fields: [vatOutputAccountId], references: [id])

  vatInputAccountId String?         @map("vat_input_account_id") @db.Uuid
  vatInputAccount   ChartOfAccount? @relation("PostingVatInput", fields: [vatInputAccountId], references: [id])

  roundDifferenceAccountId String?         @map("round_difference_account_id") @db.Uuid
  roundDifferenceAccount   ChartOfAccount? @relation("PostingRoundDifference", fields: [roundDifferenceAccountId], references: [id])

  /// TASK-055 — completes the Accounting Settings surface. Purchase
  /// Discount/Exchange Difference/Suspense stay prepared-but-unwired, same
  /// treatment as Sales Discount/Return above (no FX revaluation or
  /// discount-splitting engine exists to consume them). Retained Earnings
  /// IS wired — FiscalYearsService.close() posts the year's net P&L to it.
  purchaseDiscountAccountId String?         @map("purchase_discount_account_id") @db.Uuid
  purchaseDiscountAccount   ChartOfAccount? @relation("PostingPurchaseDiscount", fields: [purchaseDiscountAccountId], references: [id])

  exchangeDifferenceAccountId String?         @map("exchange_difference_account_id") @db.Uuid
  exchangeDifferenceAccount   ChartOfAccount? @relation("PostingExchangeDifference", fields: [exchangeDifferenceAccountId], references: [id])

  suspenseAccountId String?         @map("suspense_account_id") @db.Uuid
  suspenseAccount   ChartOfAccount? @relation("PostingSuspense", fields: [suspenseAccountId], references: [id])

  retainedEarningsAccountId String?         @map("retained_earnings_account_id") @db.Uuid
  retainedEarningsAccount   ChartOfAccount? @relation("PostingRetainedEarnings", fields: [retainedEarningsAccountId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("posting_settings")
}

// ---------------------------------------------------------------------------
// Import Center (TASK-056) — architecture only: Import Job lifecycle, a
// plug-in registry of Import Types (each wrapping an EXISTING domain
// service — CustomersService.create(), InventoryService.adjustment(), ...
// — never a parallel write path into Prisma), and a generic CSV Mapping
// Engine. Connectors (Google Sheets, Bank Statements, external APIs,
// Marketplaces) are explicitly NOT implemented — `sourceConnector` exists
// only so a future connector can tag which jobs it created.
// ---------------------------------------------------------------------------

enum ImportJobStatus {
  DRAFT
  UPLOADING
  MAPPING
  VALIDATING
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

/// One row per upload-through-import run. `fileContent` holds the raw
/// decoded file text (CSV today) — this "architecture only" phase never
/// touches external/object storage; that's a clean future swap, not a
/// blocker (same "prepared, not wired" precedent as `PostingSettings`'s
/// unwired fields elsewhere in this schema). `columnMapping` is
/// `{ [fieldKey]: sourceColumnHeader }`.
model ImportJob {
  id String @id @default(uuid()) @db.Uuid

  importType String          @map("import_type")
  status     ImportJobStatus @default(DRAFT)

  fileName      String @map("file_name")
  fileContent   String @map("file_content")
  columnMapping Json?  @map("column_mapping")

  /// Not implemented by any connector yet (TASK-056 Part 7) — reserved so a
  /// future Bank/API/Marketplace connector can tag the jobs it creates
  /// without a schema change; `null` means "manual upload." The Google
  /// Sheets connector (Phase 1) is the first to actually set this, to
  /// `"google-sheets"`.
  sourceConnector String? @map("source_connector")

  /// The Google Sheets share URL a job was created/refreshed from — only
  /// set when `sourceConnector = "google-sheets"`. Lets "Manual Refresh"
  /// re-fetch the same sheet without the user re-pasting the URL.
  sourceUrl String? @map("source_url")

  /// Architecture placeholder only (Phase 1 — "prepare architecture for
  /// scheduled refresh, do NOT implement a scheduler now"). No cron/queue
  /// reads this column yet; it exists so a future scheduler can store its
  /// config here without another migration.
  scheduleConfig Json? @map("schedule_config")

  /// Sync status (Part 4 — "prominent refresh button... last successful/
  /// attempted sync, current status"), source-connector jobs only.
  /// `lastAttemptedAt` is set on every `refresh()` call regardless of
  /// outcome; `lastSyncedAt` only on a successful one, so the UI can show
  /// "last attempt failed, still showing data from <lastSyncedAt>".
  /// `isSyncing` is a simple advisory lock — `refresh()` sets it before the
  /// fetch and clears it in a `finally`, and a second concurrent refresh
  /// request is rejected while it's `true` (Part 4's "concurrent-refresh
  /// prevention"), enforced server-side, not just a disabled frontend button.
  lastSyncedAt    DateTime? @map("last_synced_at")
  lastAttemptedAt DateTime? @map("last_attempted_at")
  isSyncing       Boolean   @default(false) @map("is_syncing")

  totalRows    Int @default(0) @map("total_rows")
  successCount Int @default(0) @map("success_count")
  errorCount   Int @default(0) @map("error_count")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  /// Data Synchronization only (`SyncOrchestratorService`) — constant
  /// field values merged into every mapped row when the source sheet has
  /// no column for them (e.g. a Cash Flow worksheet's provider label, or
  /// this job's own id for traceability) — `ImportJobsService.validate()`/
  /// `run()` apply these as a fallback only, never overriding an actual
  /// column mapping. Null for a plain manual upload.
  rowDefaults Json? @map("row_defaults")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  errors           ImportJobError[]
  bankTransactions BankTransaction[]
  syncSourceConfig SyncSourceConfig?

  @@map("import_jobs")
}

enum SyncSourceType {
  LEADS
  STORE_ORDERS
  CASH_FLOW
  /// Two-way Store Orders / Shipping workflow — reads Shipping Status/
  /// Tracking Number/Shipping Company from the SAME spreadsheet row a
  /// STORE_ORDERS source already imported (matched by the same External
  /// Order ID, never a row number), through the existing
  /// `ShippingUpdatesImportHandler` — never a second shipping pipeline.
  SHIPPING_UPDATES
}

enum SyncRunStatus {
  NEVER_RUN
  SUCCESS
  PARTIAL
  FAILED
}

/// Data Synchronization (مزامنة البيانات) — a persistent, named Google
/// Sheets source a privileged user configures once per module (Leads,
/// Store Orders) or once per provider tab (Cash Flow: one row per bank/
/// wallet/BNPL worksheet, never hardcoded). Reuses the Import Center engine
/// end to end — `SyncOrchestratorService` builds a fresh `ImportJob` from
/// this config's saved spreadsheet/mapping on every Preview/Commit cycle
/// (an `ImportJob` is documented as "one row per upload-through-import
/// run" — a sync run is exactly that, never a long-lived job repeatedly
/// refreshed), never a parallel import pipeline. `importJobId` always
/// points at the most recent such run, for traceability and the "Last
/// Sync" summary below.
model SyncSourceConfig {
  id String @id @default(uuid()) @db.Uuid

  sourceType SyncSourceType @map("source_type")

  /// Display name — the module name for Leads/Store Orders, or the
  /// provider name (e.g. "Al Rajhi", "Tabby") for a Cash Flow tab. Also
  /// used as the fallback value for fields the sheet itself has no column
  /// for (see `ImportJob.rowDefaults`).
  label String

  spreadsheetId String  @map("spreadsheet_id")
  /// The worksheet's numeric gid — `undefined`/null resolves to the
  /// spreadsheet's first sheet, same convention as `parseGoogleSheetsUrl`.
  worksheetGid  String? @map("worksheet_gid")
  /// Cached tab title for display only — resolved from the spreadsheet on
  /// save, re-resolved on every sync; never the identity (`worksheetGid`/
  /// index is).
  worksheetName String? @map("worksheet_name")

  enabled Boolean @default(true)

  /// Concurrency guard (spec: "do not allow two synchronization jobs to
  /// process the same source concurrently") — set true for the duration of
  /// one `preview()`/`commit()` call, mirroring `ImportJob.isSyncing`'s
  /// existing advisory-lock pattern one level up (per-source instead of
  /// per-job, since this engine builds a fresh `ImportJob` every run).
  isSyncing Boolean @default(false) @map("is_syncing")

  importJobId String?    @unique @map("import_job_id") @db.Uuid
  importJob   ImportJob? @relation(fields: [importJobId], references: [id])

  lastSyncedAt    DateTime?     @map("last_synced_at")
  lastSyncStatus  SyncRunStatus @default(NEVER_RUN) @map("last_sync_status")
  lastSyncUserId  String?       @map("last_sync_user_id") @db.Uuid
  /// The same `{totalRows, newCount, duplicateCount, needsReviewCount,
  /// rejectedCount, errorCount}` shape `SyncOrchestratorService.commit()`
  /// returns — stored so the "Last Sync" summary survives a page reload
  /// without re-fetching the sheet.
  lastSyncSummary Json?         @map("last_sync_summary")

  /// Free-form per-source settings (e.g. a saved `ImportMappingTemplate`
  /// name) — architecture placeholder for source-specific config that
  /// doesn't need its own column yet.
  configMetadata Json? @map("config_metadata")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@unique([sourceType, spreadsheetId, worksheetGid])
  @@map("sync_source_configs")
}

/// One row per failed source row — never silently dropped (Part 6).
model ImportJobError {
  id String @id @default(uuid()) @db.Uuid

  importJobId String    @map("import_job_id") @db.Uuid
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  rowNumber    Int     @map("row_number")
  columnName   String? @map("column_name")
  errorMessage String  @map("error_message")
  suggestedFix String? @map("suggested_fix")
  /// The raw source row, so "Download Error Report" can round-trip a
  /// corrected file without the user re-locating each row in the original.
  rawRowData   Json    @map("raw_row_data")

  /// Set only for a needs-review row (see `NEEDS_REVIEW_PREFIX`) the user
  /// explicitly rejected — the row is kept (never deleted) so the reason
  /// stays visible in the review/report UI, unlike a Confirmed row which is
  /// deleted once written for real. `rejectionReasonCode` is one of a fixed
  /// set (DUPLICATE_ORDER/INVALID_PHONE/.../OTHER); `rejectionReasonNote` is
  /// the free-text reason required only when the code is OTHER.
  rejectionReasonCode String?   @map("rejection_reason_code")
  rejectionReasonNote String?   @map("rejection_reason_note")
  rejectedAt          DateTime? @map("rejected_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("import_job_errors")
}

/// "Save Mapping Template" (Part 4) — a reusable column mapping for a given
/// Import Type, so a recurring import (e.g. a monthly supplier price file)
/// never needs re-mapping.
model ImportMappingTemplate {
  id String @id @default(uuid()) @db.Uuid

  importType    String @map("import_type")
  name          String
  columnMapping Json   @map("column_mapping")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([importType, name])
  @@map("import_mapping_templates")
}
