  description String?

  /// Accounting Configuration (TASK-047) — optional group-level overrides;
  /// a Supplier's own defaultPayableAccountId still takes priority over
  /// this (resolved by AccountMappingService).
  defaultPayableAccountId String?         @map("default_payable_account_id") @db.Uuid
  defaultPayableAccount   ChartOfAccount? @relation("SupplierGroupDefaultPayable", fields: [defaultPayableAccountId], references: [id])

  defaultPurchaseAccountId String?         @map("default_purchase_account_id") @db.Uuid
