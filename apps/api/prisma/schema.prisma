// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  username           String    @unique
  fullName           String    @map("full_name")
  passwordHash       String    @map("password_hash")
  mobile             String?
  isActive           Boolean   @default(true) @map("is_active")
  /// TASK-060 — set by "Lock"/"Unlock", independent of `isActive`: Active/Inactive is an admin-toggled field, Lock is a security action (e.g. after a manual lock or a future failed-login policy). A locked user cannot log in even if `isActive` is true.
  isLocked           Boolean   @default(false) @map("is_locked")
  /// TASK-060 — "Force Password Change": the next successful login must change the password before doing anything else.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  /// System-level bypass, orthogonal to `UserPermission` grants (still no Role/RBAC layer — this is a single superuser flag, not a role). A super admin always passes every permission check, including actions with no registered catalog entry; individual `UserPermission` rows are still recorded and shown for audit/UI, they just stop being the gate for this user. Defaults false; must be granted explicitly, never inferred from a permission count.
  isSuperAdmin       Boolean   @default(false) @map("is_super_admin")

  jobTitleId String?   @map("job_title_id") @db.Uuid
  jobTitle   JobTitle? @relation(fields: [jobTitleId], references: [id])

  /// Canonical company Department (Master Data) — never free text.
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  /// TASK-060 — the user's assigned Branch (distinct from `CompanyMembership.branchId`, which is a per-company default). Simple direct FK, matching the flat "Branch" field the Users form asks for.
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  /// TASK-060 — "Permissions are assigned directly to each user" (no Role/RBAC layer). See `UserPermission`.
  userPermissions     UserPermission[]
  companyMemberships  CompanyMembership[]
  passwordResetTokens PasswordResetToken[]

  leadsAsSalesEmployee Lead[]
  leadAssignments      LeadAssignment[]
  leadAssignmentsFrom  LeadAssignment[] @relation("LeadAssignmentFrom")
  leadAssignmentsActor LeadAssignment[] @relation("LeadAssignmentActor")
  leadNotes            LeadNote[]
  leadFollowUps        LeadFollowUp[]

  salesOrdersAsSalesEmployee      SalesOrder[]           @relation("SalesOrderSalesEmployee")
  salesOrdersAsShippingEmployee   SalesOrder[]           @relation("SalesOrderShippingEmployee")
  salesOrdersAsCreatedBy          SalesOrder[]           @relation("SalesOrderCreatedBy")
  salesOrdersAsPaymentVerifiedBy  SalesOrder[]           @relation("SalesOrderPaymentVerifiedBy")
  salesOrdersAsPackedBy           SalesOrder[]           @relation("SalesOrderPackedBy")
  salesOrdersAsHandedToShippingBy SalesOrder[]           @relation("SalesOrderHandedToShippingBy")
  salesOrderNotes                 SalesOrderNote[]
  salesOrderAttachments           SalesOrderAttachment[]

  paymentNotes         PaymentNote[]
  paymentAttachments   PaymentAttachment[]
  uploadedAttachments  Attachment[]        @relation("AttachmentUploadedBy")
  deletedAttachments   Attachment[]        @relation("AttachmentDeletedBy")
  paymentsAsMatchedBy  Payment[]           @relation("PaymentMatchedBy")
  paymentsAsVerifiedBy Payment[]           @relation("PaymentVerifiedBy")
  paymentsAsRejectedBy Payment[]           @relation("PaymentRejectedBy")

  bankTransactionsAsMatchedBy BankTransaction[] @relation("BankTransactionMatchedBy")

  productAttachments ProductAttachment[]
  managedWarehouses  Warehouse[]
  inventoryMovements InventoryMovement[]

  /// Store Orders + Shipping Operations — independent order pipeline, not
  /// routed through Lead/SalesOrder. See the StoreOrder model comment.
  storeOrdersAsEmployee    StoreOrder[]         @relation("StoreOrderEmployee")
  storeOrderReceiptUploads StoreOrderReceipt[]
  storeOrderActivities     StoreOrderActivity[]

  statusHistoryChanges     StatusHistory[]      @relation("StatusHistoryChangedBy")
  workflowApprovalsRequested WorkflowApproval[] @relation("WorkflowApprovalRequestedBy")
  workflowApprovalsApproved  WorkflowApproval[] @relation("WorkflowApprovalApprovedBy")
  workflowApprovalsRejected  WorkflowApproval[] @relation("WorkflowApprovalRejectedBy")

  /// Unified Partner Architecture — optional link from an EMPLOYEE-role
  /// Partner to this system account.
  employeeProfile EmployeeProfile?

  managedSalesTeams SalesTeam[]       @relation("SalesTeamManager")
  salesTeamMembers  SalesTeamMember[]

  @@index([departmentId])
  @@map("users")
}

/// TASK-060 — "Job Title is ONLY a label. Real access is controlled ONLY by
/// Permissions." A closed, admin-seeded list (see seed.ts's 8 Arabic
/// titles) — never joined into any permission check anywhere in this
/// codebase. Replaces the old `Role` model, which conflated "job title" with
/// "permission grant" (Odoo-style RBAC) — explicitly forbidden by this task.
model JobTitle {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  employeeProfiles EmployeeProfile[]

  @@map("job_titles")
}

/// Company-wide organizational Department — the ONE authoritative Master
/// Data source for department selection (Users, Sales Teams, future HR).
/// Distinct from SalesTeam: a Department (المبيعات) can own many teams.
model Department {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  nameEn      String? @map("name_en")
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  users                 User[]
  salesTeams            SalesTeam[]
  distributionPolicies  LeadDistributionPolicy[]

  @@index([deletedAt, isActive, sortOrder])
  @@map("departments")
}

/// Descriptive commercial segmentation for Leads — never a workflow status,
/// never an action. Color is a StatusDefinition-style semantic token
/// (info/success/warning/destructive/neutral), not a raw CSS string.
model CustomerClassification {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  nameEn      String? @map("name_en")
  description String?
  color       String  @default("neutral")
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  leads             Lead[]
  suggestedReasons  NoPurchaseReason[] @relation("ClassificationSuggestedReasons")

  @@index([deletedAt, isActive, sortOrder])
  @@map("customer_classifications")
}

/// Configurable reasons for closing a Lead without purchase. Historical
/// usage remains after archive; new selection is active rows only.
model NoPurchaseReason {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  nameEn      String? @map("name_en")
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  leads            Lead[]
  classifications  CustomerClassification[] @relation("ClassificationSuggestedReasons")

  @@index([deletedAt, isActive, sortOrder])
  @@map("no_purchase_reasons")
}

/// A sales working group under a Department — never itself a Department.
/// Manager + members are Users; departmentId is the canonical FK.
model SalesTeam {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique
  name String

  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])

  managerId String @map("manager_id") @db.Uuid
  manager   User   @relation("SalesTeamManager", fields: [managerId], references: [id])

  isActive Boolean @default(true) @map("is_active")
  notes    String?

  distributionPolicies LeadDistributionPolicy[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  members SalesTeamMember[]

  @@index([departmentId])
  @@index([managerId])
  @@map("sales_teams")
}

model SalesTeamMember {
  id String @id @default(uuid()) @db.Uuid

  salesTeamId String    @map("sales_team_id") @db.Uuid
  salesTeam   SalesTeam @relation(fields: [salesTeamId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([salesTeamId, userId])
  @@index([userId])
  @@map("sales_team_members")
}

/// TASK-060 — the full catalog of grantable permission strings
/// (`module.action`, e.g. `sales.invoices.create`). Unchanged shape from the
/// pre-TASK-060 schema — only how a permission reaches a user changes (see
/// `UserPermission`), not the catalog itself.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  userPermissions UserPermission[]

  @@map("permissions")
}

/// TASK-060 — "Permissions are assigned directly to each user." The ONLY
/// place a permission grant lives; there is no Role/RolePermission layer.
/// "Copy Permissions From" (Part 9) reads another user's rows here and
/// inserts matching rows for the target user — user-to-user only, never a
/// Role template.
model UserPermission {
  id String @id @default(uuid()) @db.Uuid

  userId       String @map("user_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// ---------------------------------------------------------------------------
// Auth + Company Context (ADR-0022 foundation) — every future API request
// must be scoped to a Company (and optionally a Branch). A user can belong
// to more than one Company (multi-company support); CompanyMembership is the
// join that also carries the branch a membership defaults to. No business
// logic depends on these yet — this is the auth/context foundation only.
// ---------------------------------------------------------------------------
model Company {
  id   String @id @default(uuid()) @db.Uuid
  name String
  code String @unique

  logoUrl        String? @map("logo_url")
  primaryColor   String? @map("primary_color")
  secondaryColor String? @map("secondary_color")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  branches       Branch[]
  memberships    CompanyMembership[]
  journalEntries JournalEntry[]

  /// TASK-051 Document Context Enrichment — ambient scoping on every operational document.
  salesQuotations       SalesQuotation[]
  salesOrderDocuments   SalesOrderDocument[]
  salesInvoices         SalesInvoice[]
  salesReturns          SalesReturn[]
  purchaseQuotations    PurchaseQuotation[]
  purchaseOrders        PurchaseOrder[]
  purchaseInvoices      PurchaseInvoice[]
  purchaseReturns       PurchaseReturn[]
  financialTransactions FinancialTransaction[]
  fiscalYears           FiscalYear[]
  journals              Journal[]

  @@map("companies")
}

model Branch {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String
  code      String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  company        Company             @relation(fields: [companyId], references: [id])
  memberships    CompanyMembership[]
  journalEntries JournalEntry[]
  /// TASK-060 — Users form's "Branch" field.
  users          User[]

  /// TASK-051 Document Context Enrichment — ambient scoping on every operational document.
  salesQuotations       SalesQuotation[]
  salesOrderDocuments   SalesOrderDocument[]
  salesInvoices         SalesInvoice[]
  salesReturns          SalesReturn[]
  purchaseQuotations    PurchaseQuotation[]
  purchaseOrders        PurchaseOrder[]
  purchaseInvoices      PurchaseInvoice[]
  purchaseReturns       PurchaseReturn[]
  financialTransactions FinancialTransaction[]
  journals              Journal[]

  @@unique([companyId, code])
  @@map("branches")
}

model CompanyMembership {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  branchId  String? @map("branch_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, companyId])
  @@map("company_memberships")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Reference Data — system master data referenced by future business modules
// (Products, Customers, Orders, Accounting, Shipping, Reports). These entities
// are independent of each other and of those future modules.
// ---------------------------------------------------------------------------

model Currency {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  name   String
  symbol String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  leads                   Lead[]
  salesOrders             SalesOrder[]
  storeOrders             StoreOrder[]
  payments                Payment[]
  receivingAccounts       ReceivingAccount[]
  partners                Partner[]
  purchaseOrders          PurchaseOrder[]
  salesQuotations         SalesQuotation[]
  countriesDefaultingHere Country[]
  bankTransactions        BankTransaction[]
  salesOrderDocuments     SalesOrderDocument[]
  salesInvoices           SalesInvoice[]
  salesReturns            SalesReturn[]
  purchaseQuotations      PurchaseQuotation[]
  purchaseInvoices        PurchaseInvoice[]
  purchaseReturns         PurchaseReturn[]
  financialTransactions   FinancialTransaction[]
  journalEntries          JournalEntry[]
  journals                Journal[]
  chartOfAccounts         ChartOfAccount[]

  @@map("currencies")
}

/// Ships with a full international dataset (seeded from libphonenumber-js's
/// own supported-region list + the `i18n-iso-countries` reference package —
/// never hand-typed codes) instead of being admin-created master data.
model Country {
  id     String  @id @default(uuid()) @db.Uuid
  /// ISO 3166-1 alpha-2 — the one code the phone-validation architecture
  /// already keys everything off of.
  code   String  @unique
  /// Arabic name — primary identity, matches the Product/Lead convention.
  name   String
  nameEn String? @map("name_en")

  /// ISO 3166-1 alpha-3 / numeric — reference identifiers, not used for
  /// lookups anywhere yet.
  iso3        String? @db.Char(3)
  numericCode String? @map("numeric_code") @db.Char(3)

  /// Denormalized from libphonenumber-js purely for contexts that need a
  /// calling code without loading the phone library (exports, other
  /// services) — actual phone validation still resolves live from `code`
  /// via `PhoneNumberService`/`phone-service.ts`, never trusts this column,
  /// so it can never drift into being a second source of truth for validity.
  callingCode String? @map("calling_code")

  /// Distinct from `deletedAt` (soft-delete/archive): lets a specific
  /// country be hidden from selection without removing the reference row —
  /// e.g. a sanctioned/unsupported territory the business doesn't serve.
  isActive Boolean @default(true) @map("is_active")

  defaultCurrencyId String?   @map("default_currency_id") @db.Uuid
  defaultCurrency   Currency? @relation(fields: [defaultCurrencyId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  leads       Lead[]
  salesOrders SalesOrder[]
  cities      City[]
  partners    Partner[]

  @@map("countries")
}

model Project {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  salesOrders       SalesOrder[]
  purchaseOrders    PurchaseOrder[]
  journalEntries    JournalEntry[]
  journalEntryLines JournalEntryLine[]

  /// TASK-051 Document Context Enrichment — posting documents only (Quotations/Orders don't carry cost attribution).
  salesInvoices         SalesInvoice[]
  salesReturns          SalesReturn[]
  purchaseInvoices      PurchaseInvoice[]
  purchaseReturns       PurchaseReturn[]
  financialTransactions FinancialTransaction[]
  bankTransactions      BankTransaction[]

  @@map("projects")
}

model CostCenter {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  salesOrders       SalesOrder[]
  purchaseOrders    PurchaseOrder[]
  journalEntries    JournalEntry[]
  journalEntryLines JournalEntryLine[]

  /// TASK-051 Document Context Enrichment — posting documents only (Quotations/Orders don't carry cost attribution).
  salesInvoices         SalesInvoice[]
  salesReturns          SalesReturn[]
  purchaseInvoices      PurchaseInvoice[]
  purchaseReturns       PurchaseReturn[]
  financialTransactions FinancialTransaction[]
  expenses              Expense[]
  fixedAssets           FixedAsset[]
  bankTransactions      BankTransaction[]

  @@map("cost_centers")
}

/// Google Sheets Readiness (2026-08-13) — every Payment Method must now
/// identify its linked accounting account, so an imported/reconciled
/// transaction always resolves to a real Chart of Accounts destination
/// (spec section 5). Nullable at the DB level only because 4 rows already
/// existed with no account (same nullable-for-backfill compromise as
/// `PaymentSource.code`) — the Create DTO requires it for every new row,
/// and the service never auto-creates the account itself (the user must
/// create it first in Chart of Accounts).  Deliberately still has no
/// Currency/Country field — a Payment Method identifies the channel +
/// account only; Currency/Country belong to the transaction (spec 7/8).
model PaymentMethod {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  accountId String?         @map("account_id") @db.Uuid
  account   ChartOfAccount? @relation("PaymentMethodAccount", fields: [accountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  salesOrders SalesOrder[]
  expenses    Expense[]

  @@map("payment_methods")
}

/// A simple recorded expense — date/amount/description, optionally
/// attributed to a Cost Center and a Payment Method. No approval workflow,
/// no journal-entry posting: same "architecture only, no accounting math
/// yet" scoping the Cost Engine Foundation (ADR-0014) already applied to
/// Purchasing — a future Accounting module can add posting on top of this.
model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  description String

  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  paymentMethodId String?        @map("payment_method_id") @db.Uuid
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("expenses")
}

/// A simple fixed-asset register entry — name/acquisition date/cost,
/// optionally attributed to a Cost Center. No depreciation calculation, no
/// journal-entry posting: same "architecture only" scoping as Expense —
/// a future Accounting module can add depreciation schedules on top.
model FixedAsset {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  code            String?
  acquisitionDate DateTime @map("acquisition_date") @db.Date
  cost            Decimal  @db.Decimal(12, 2)

  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("fixed_assets")
}

/// Master Data — Payment Terms (TASK-028). Distinct from PaymentMethod:
/// PaymentMethod answers "how" (Cash, Card, Transfer); PaymentTerm answers
/// "when payment is due" (Net 30, Due on Receipt, COD). `days` is nullable
/// since not every term is day-based (e.g. "Cash on Delivery"). Code is
/// auto-generated via the Numbering Engine, same as every other TASK-030+
/// master-data entity — never typed by hand.
model PaymentTerm {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  days        Int?
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  customerProfiles CustomerProfile[]

  @@map("payment_terms")
}

/// Discriminates the two future shipping-method types. The internal delivery
/// representative module itself is explicitly deferred — this enum only
/// prepares the architecture to distinguish the two categories.
enum ShippingMethodType {
  INTERNAL_DELIVERY
  EXTERNAL_COMPANY
}

model ShippingMethod {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  type        ShippingMethodType
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("shipping_methods")
}

model ProductCategory {
  id          String  @id @default(uuid()) @db.Uuid
  /// Not `@unique` here — uniqueness is enforced only among active
  /// (non-archived) rows via a partial unique index added in a raw-SQL
  /// migration (Prisma's schema DSL can't express a `WHERE deleted_at IS
  /// NULL` index), so a name freed up by archiving can be reused.
  name        String
  description String?

  /// Accounting Configuration (TASK-047) — optional per-category overrides
  /// of the global Accounting Settings defaults. Empty means "use the
  /// global default" — resolved by AccountMappingService, never here.
  revenueAccountId String?         @map("revenue_account_id") @db.Uuid
  revenueAccount   ChartOfAccount? @relation("CategoryRevenueAccount", fields: [revenueAccountId], references: [id])

  inventoryAccountId String?         @map("inventory_account_id") @db.Uuid
  inventoryAccount   ChartOfAccount? @relation("CategoryInventoryAccount", fields: [inventoryAccountId], references: [id])

  cogsAccountId String?         @map("cogs_account_id") @db.Uuid
  cogsAccount   ChartOfAccount? @relation("CategoryCogsAccount", fields: [cogsAccountId], references: [id])

  purchaseAccountId String?         @map("purchase_account_id") @db.Uuid
  purchaseAccount   ChartOfAccount? @relation("CategoryPurchaseAccount", fields: [purchaseAccountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@map("product_categories")
}

model ProductBrand {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  products Product[]

  @@map("product_brands")
}

/// Reference Data — Product Engine Foundation. "Support examples: Piece, Box,
/// Pack, Book, Carton, Kilogram, Gram, Liter, Meter." Future unit conversion
/// is explicitly out of scope — this is a flat named list only.
model Unit {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  products                Product[]
  purchaseOrderItems      PurchaseOrderItem[]
  conversionsFrom         UnitConversion[]         @relation("UnitConversionFrom")
  conversionsTo           UnitConversion[]         @relation("UnitConversionTo")
  salesQuotationItems     SalesQuotationItem[]
  salesOrderDocumentItems SalesOrderDocumentItem[]
  salesInvoiceItems       SalesInvoiceItem[]
  salesReturnItems        SalesReturnItem[]
  purchaseQuotationItems  PurchaseQuotationItem[]
  purchaseInvoiceItems    PurchaseInvoiceItem[]
  purchaseReturnItems     PurchaseReturnItem[]

  @@map("units")
}

/// Units of Measure — Conversions (TASK-030). `Unit` itself stays the flat
/// named list it always was (ADR-0011/0012); this table separately records
/// "1 fromUnit = ratio toUnit" pairs (e.g. Box -> Piece = 12, Kilogram ->
/// Gram = 1000) so a future Purchasing/Sales module can convert between a
/// product's purchase/sales unit and its base unit. Not wired onto Product
/// yet — no purchaseUnitId/salesUnitId column was added there, which would
/// expand Product Engine's already-closed scope (ADR-0012); this is the
/// reference table those future columns would point through.
model UnitConversion {
  id String @id @default(uuid()) @db.Uuid

  fromUnitId String @map("from_unit_id") @db.Uuid
  fromUnit   Unit   @relation("UnitConversionFrom", fields: [fromUnitId], references: [id])

  toUnitId String @map("to_unit_id") @db.Uuid
  toUnit   Unit   @relation("UnitConversionTo", fields: [toUnitId], references: [id])

  /// "1 fromUnit = conversionRatio toUnit" — e.g. fromUnit=Box, toUnit=Piece, ratio=12.
  conversionRatio Decimal @map("conversion_ratio") @db.Decimal(18, 6)

  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@unique([fromUnitId, toUnitId])
  @@map("unit_conversions")
}

model Warehouse {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  /// Inventory Engine Foundation (ADR-0013) additions.
  isDefault Boolean @default(false) @map("is_default")

  /// No closed set of values was specified, so this is a free-text
  /// classifier rather than an invented enum (same reasoning as
  /// Product.defaultCostMethod/defaultTaxCategory in ADR-0012).
  warehouseType String? @map("warehouse_type")

  isActive Boolean @default(true) @map("is_active")

  /// Future warehouse hierarchy — prepared only: a nullable self-relation,
  /// no depth limit, no cycle detection, no traversal API. Real FK since
  /// Warehouse already exists (unlike Product's future-column placeholders).
  parentWarehouseId String?     @map("parent_warehouse_id") @db.Uuid
  parentWarehouse   Warehouse?  @relation("WarehouseHierarchy", fields: [parentWarehouseId], references: [id])
  childWarehouses   Warehouse[] @relation("WarehouseHierarchy")

  /// TASK-028 Part 3 — real FKs, not free-text: the person responsible for
  /// this warehouse (User already exists) and the analytic account its
  /// inventory activity should default to (AnalyticAccount already exists).
  managerId String? @map("manager_id") @db.Uuid
  manager   User?   @relation(fields: [managerId], references: [id])

  defaultAnalyticAccountId String?          @map("default_analytic_account_id") @db.Uuid
  defaultAnalyticAccount   AnalyticAccount? @relation(fields: [defaultAnalyticAccountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  salesOrders             SalesOrder[]
  inventoryMovements      InventoryMovement[]
  locations               WarehouseLocation[]
  preferredByProducts     Product[]
  physicalCounts          PhysicalCount[]
  salesQuotationItems     SalesQuotationItem[]
  salesOrderDocumentItems SalesOrderDocumentItem[]
  salesInvoiceItems       SalesInvoiceItem[]
  salesReturnItems        SalesReturnItem[]
  purchaseInvoiceItems    PurchaseInvoiceItem[]
  purchaseReturnItems     PurchaseReturnItem[]

  @@map("warehouses")
}

/// Warehouse Locations (TASK-030) — unlimited bins/shelves/zones per
/// Warehouse (e.g. Main Warehouse > A1, A2, B1, B2, Returns, Damaged), tree
/// via a nullable self-relation the same way Warehouse itself models its
/// own future hierarchy (ADR-0013). No inventory-quantity or costing field
/// lives here — a Location is purely a place; InventoryMovement stays the
/// only source of quantity truth (ADR-0013).
model WarehouseLocation {
  id String @id @default(uuid()) @db.Uuid

  /// App-generated ("LOC-000001", ...) via the Numbering Engine — never
  /// typed by hand, same treatment as Warehouse.code.
  code String @unique

  name        String
  description String?

  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  parentLocationId String?             @map("parent_location_id") @db.Uuid
  parentLocation   WarehouseLocation?  @relation("WarehouseLocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations   WarehouseLocation[] @relation("WarehouseLocationHierarchy")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("warehouse_locations")
}

/// Reference Data — Sales Orders Phase 2, decision #2: Shipping Company must be a
/// reference-data entity, never free text.
model ShippingCompany {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  /// INTERNAL_DELIVERY vs EXTERNAL_COMPANY — absorbed from ShippingMethod.
  type        ShippingMethodType @default(EXTERNAL_COMPANY)
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  shipments Shipment[]

  @@map("shipping_companies")
}

/// Shipping Status Configuration + Final-Shipment Sync Rules — whether a
/// Shipment carrying this status is still a live candidate for future
/// Shipping Sync runs (`UNDER_SYNC`) or permanently done (`FINAL`, e.g. تم
/// التسليم / تم الإرجاع). `ShippingUpdatesImportHandler` reads this on the
/// CURRENT shipment before touching anything else — a FINAL shipment is
/// skipped outright, never revalidated/rewritten, until a human manually
/// moves it back to an UNDER_SYNC status.
enum ShippingSyncBehavior {
  UNDER_SYNC
  FINAL
}

/// Dynamic shipping-status catalog — names, colors, and List Sheet values.
/// `Shipment.status` remains the operational state machine for seeded system
/// codes; this table is the source of truth for display, import resolution,
/// and administrator-created statuses. `جاهز للشحن` is the protected default.
model ShippingStatus {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  /// Not `@unique` here — uniqueness is enforced only among ACTIVE
  /// (non-archived) rows via a partial unique index added in a raw-SQL
  /// migration (same pattern as ProductCategory.name), so a name freed up
  /// by archiving can be reused. See migration
  /// `shipping_status_sync_behavior_and_active_uniques`.
  name         String
  /// Closed StatusTone token: success | warning | destructive | info | neutral
  color        String  @default("neutral")
  isSystem     Boolean @default(false) @map("is_system")
  /// Exactly one ACTIVE row may be true — enforced here at the service layer
  /// (reject a second default, name the existing one) AND at the database
  /// level via a partial unique index (same migration as `name` above), so
  /// two concurrent "set as default" requests can never both win.
  isDefault    Boolean @default(false) @map("is_default")
  isImportable Boolean @default(true) @map("is_importable")
  sortOrder    Int     @default(0) @map("sort_order")

  /// Shipping Status Configuration + Final-Shipment Sync Rules.
  syncBehavior ShippingSyncBehavior @default(UNDER_SYNC) @map("sync_behavior")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  shipments Shipment[]

  @@index([deletedAt])
  @@map("shipping_statuses")
}

// ---------------------------------------------------------------------------
// Dynamic Workflow + Status Master Data — reusable across Lead, Order,
// Payment, Fulfillment, Matching, and Reconciliation domains. Business
// statuses are database records (not application enums); stable `code` drives
// logic while `name`/`color` are admin-configurable display metadata.
// ShippingStatus remains a specialized catalog for shipment lifecycle sync;
// FULFILLMENT workflow statuses cover order-level fulfillment gates separately.
// ---------------------------------------------------------------------------

enum WorkflowType {
  LEAD
  ORDER
  PAYMENT
  FULFILLMENT
  MATCHING
  RECONCILIATION
}

enum StatusChangeSource {
  USER
  IMPORT
  SYSTEM
  MATCHING_ENGINE
  SHIPPING_SYNC
  WORKFLOW_ENGINE
}

enum WorkflowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Protected business operations triggered by specific transitions — never a
/// simple status write. `NONE` = display/workflow transition only.
enum WorkflowBusinessAction {
  NONE
  LEAD_CONVERT
  PAYMENT_RECONCILE
  SHIPMENT_CREATE
}

model StatusDefinition {
  id           String       @id @default(uuid()) @db.Uuid
  workflowType WorkflowType @map("workflow_type")
  code         String
  name         String
  nameEn       String?      @map("name_en")
  /// Closed StatusTone token — same vocabulary as ShippingStatus / StatusBadge.
  color        String       @default("neutral")
  sortOrder    Int          @default(0) @map("sort_order")
  isSystem     Boolean      @default(false) @map("is_system")
  isFinal      Boolean      @default(false) @map("is_final")
  isDefault    Boolean      @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  leadsAsCurrent            Lead[]
  storeOrdersAsPayment      StoreOrder[]         @relation("StoreOrderPaymentStatusDef")
  storeOrdersAsFulfillment  StoreOrder[]         @relation("StoreOrderFulfillmentStatusDef")
  bankTransactionsAsMatch   BankTransaction[]    @relation("BankTransactionMatchStatusDef")
  transitionsFrom           WorkflowTransition[] @relation("TransitionFromStatus")
  transitionsTo             WorkflowTransition[] @relation("TransitionToStatus")
  statusHistoryFrom         StatusHistory[]      @relation("StatusHistoryFrom")
  statusHistoryTo           StatusHistory[]      @relation("StatusHistoryTo")
  workflowApprovalsFrom     WorkflowApproval[]   @relation("ApprovalFromStatus")
  workflowApprovalsTo       WorkflowApproval[]   @relation("ApprovalToStatus")

  @@unique([workflowType, code])
  @@index([workflowType, deletedAt, sortOrder])
  @@map("status_definitions")
}

model WorkflowTransition {
  id           String       @id @default(uuid()) @db.Uuid
  workflowType WorkflowType @map("workflow_type")

  fromStatusId String           @map("from_status_id") @db.Uuid
  fromStatus   StatusDefinition @relation("TransitionFromStatus", fields: [fromStatusId], references: [id])

  toStatusId String           @map("to_status_id") @db.Uuid
  toStatus   StatusDefinition @relation("TransitionToStatus", fields: [toStatusId], references: [id])

  labelAr String  @map("label_ar")
  labelEn String? @map("label_en")

  requiresApproval    Boolean @default(false) @map("requires_approval")
  requiresReason      Boolean @default(false) @map("requires_reason")
  requiredPermission  String? @map("required_permission")
  businessAction      WorkflowBusinessAction @default(NONE) @map("business_action")
  isSystemProtected   Boolean @default(false) @map("is_system_protected")
  isActive            Boolean @default(true) @map("is_active")
  sortOrder           Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  statusHistory     StatusHistory[]
  workflowApprovals WorkflowApproval[]

  @@index([workflowType, fromStatusId, isActive])
  @@map("workflow_transitions")
}

model StatusHistory {
  id String @id @default(uuid()) @db.Uuid

  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid

  fromStatusId String?           @map("from_status_id") @db.Uuid
  fromStatus   StatusDefinition? @relation("StatusHistoryFrom", fields: [fromStatusId], references: [id])

  toStatusId String           @map("to_status_id") @db.Uuid
  toStatus   StatusDefinition @relation("StatusHistoryTo", fields: [toStatusId], references: [id])

  transitionId String?             @map("transition_id") @db.Uuid
  transition   WorkflowTransition? @relation(fields: [transitionId], references: [id])

  changedById String? @map("changed_by_id") @db.Uuid
  changedBy   User?   @relation("StatusHistoryChangedBy", fields: [changedById], references: [id])

  changedAt DateTime           @default(now()) @map("changed_at")
  reason    String?
  source    StatusChangeSource @default(USER)

  @@index([entityType, entityId, changedAt])
  @@map("status_history")
}

model WorkflowApproval {
  id String @id @default(uuid()) @db.Uuid

  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid

  transitionId String             @map("transition_id") @db.Uuid
  transition   WorkflowTransition @relation(fields: [transitionId], references: [id])

  fromStatusId String           @map("from_status_id") @db.Uuid
  fromStatus   StatusDefinition @relation("ApprovalFromStatus", fields: [fromStatusId], references: [id])

  toStatusId String           @map("to_status_id") @db.Uuid
  toStatus   StatusDefinition @relation("ApprovalToStatus", fields: [toStatusId], references: [id])

  status WorkflowApprovalStatus @default(PENDING)

  requestedById String   @map("requested_by_id") @db.Uuid
  requestedBy   User     @relation("WorkflowApprovalRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now()) @map("requested_at")
  reason        String?

  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedBy   User?     @relation("WorkflowApprovalApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")

  rejectedById String?   @map("rejected_by_id") @db.Uuid
  rejectedBy   User?     @relation("WorkflowApprovalRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt   DateTime? @map("rejected_at")
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, status])
  @@index([status, requestedAt])
  @@map("workflow_approvals")
}

// ---------------------------------------------------------------------------
// CRM — Phase 1: Lead Management Foundation. Every sale starts as a Lead; this
// is intentionally simple (not a marketing CRM) — receive, distribute, and
// follow leads until they become confirmed orders. No Customer/Order/Payment
// entities exist yet — those are future modules.
// ---------------------------------------------------------------------------

/// Closed set — do not add sources beyond these three without a new decision.
enum LeadSource {
  MANUAL
  EXCEL
  GOOGLE_SHEETS
}

model Lead {
  id           String @id @default(uuid()) @db.Uuid
  leadNumber   String @unique @map("lead_number")
  customerName String @map("customer_name")
  mobileNumber String @map("mobile_number")

  countryId String  @map("country_id") @db.Uuid
  country   Country @relation(fields: [countryId], references: [id])

  /// Optional at the Lead stage — required only when saved as an Order
  /// (enforced in LeadsService.create()'s assertOrderReady(), not here, so
  /// the same column serves both minimum-fields Lead creation and the
  /// fuller Order flow).
  city    String?
  address String?

  /// A real reference to the Product catalog — required only in Order mode.
  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])
  quantity  Int

  currencyId String   @map("currency_id") @db.Uuid
  currency   Currency @relation(fields: [currencyId], references: [id])

  /// Current assignee (denormalized from the latest LeadAssignment). Null
  /// until the lead is assigned.
  salesEmployeeId String?   @map("sales_employee_id") @db.Uuid
  salesEmployee   User?     @relation(fields: [salesEmployeeId], references: [id])
  assignedAt      DateTime? @map("assigned_at")

  statusId String           @map("status_id") @db.Uuid
  status   StatusDefinition @relation(fields: [statusId], references: [id])

  /// Descriptive only — changing this MUST NOT change Lead workflow status.
  customerClassificationId String?                 @map("customer_classification_id") @db.Uuid
  customerClassification   CustomerClassification? @relation(fields: [customerClassificationId], references: [id])

  /// Set when the Lead is closed without purchase (LOST/DISQUALIFIED).
  noPurchaseReasonId String?           @map("no_purchase_reason_id") @db.Uuid
  noPurchaseReason   NoPurchaseReason? @relation(fields: [noPurchaseReasonId], references: [id])
  closeNotes         String?           @map("close_notes")

  source LeadSource

  /// Optional, no business meaning enforced yet — set when status is
  /// ARCHIVED, but that is not validated here.
  archivedReason String? @map("archived_reason")

  /// Set at creation by LeadDuplicateDetectionService when another lead
  /// shares the same mobile number + customer name but a different product.
  /// Never set by the client.
  possibleDuplicate Boolean @default(false) @map("possible_duplicate")

  /// Groups leads created by the same Excel/Google Sheets import run. Null
  /// for manually entered leads.
  importBatch String? @map("import_batch")

  /// TASK-061 — the source system's own order identifier (e.g. an e-commerce
  /// platform's order number), supplied on manual entry or import. Used to
  /// detect a re-imported duplicate order (same External Order ID) without
  /// relying on mobile+name+product matching alone. Null for leads that
  /// never carried one. Not unique at the DB level (older/manual leads have
  /// none), enforced in `LeadsService.create()` instead.
  externalOrderId String? @map("external_order_id")

  /// Nullable until Lead conversion. Lead is a CRM prospect — Partner
  /// (canonical commercial identity) is resolved/created only by
  /// LEAD_CONVERT or convertToCustomer, never at Lead creation.
  partnerId String?  @map("partner_id") @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  /// Reverse of StoreOrder.leadId — set atomically on Lead → StoreOrder conversion.
  storeOrder StoreOrder?

  /// Denormalized from the latest open LeadFollowUp.followUpAt for list/overdue.
  nextFollowUpAt DateTime? @map("next_follow_up_at")
  /// First owner detail-open that moved NEW → IN_PROGRESS. Idempotency gate.
  firstOpenedAt  DateTime? @map("first_opened_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  assignments LeadAssignment[]
  activities  LeadActivity[]
  notes       LeadNote[]
  followUps   LeadFollowUp[]
  salesOrders SalesOrder[]
  payments    Payment[]

  @@index([externalOrderId])
  @@index([statusId])
  @@index([salesEmployeeId, statusId])
  @@index([createdAt])
  @@index([countryId])
  @@index([assignedAt])
  @@index([nextFollowUpAt])
  @@index([source])
  @@index([customerClassificationId])
  @@index([noPurchaseReasonId])
  @@map("leads")
}

enum LeadAssignmentMethod {
  AUTO_CONTINUOUS
  AUTO_24H
  MANUAL
  REASSIGNMENT
  IMPORT
  SYSTEM
}

enum LeadDistributionMode {
  CONTINUOUS
  TIME_LIMITED
}

enum LeadDistributionScope {
  COMPANY
  TEAM
  DEPARTMENT
}

/// Append-only assignment history. Reassigning a lead creates a new row here
/// (and updates Lead.salesEmployeeId/assignedAt) rather than editing one.
model LeadAssignment {
  id String @id @default(uuid()) @db.Uuid

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  fromUserId String? @map("from_user_id") @db.Uuid
  fromUser   User?   @relation("LeadAssignmentFrom", fields: [fromUserId], references: [id])

  assignedToId String @map("assigned_to_id") @db.Uuid
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  method LeadAssignmentMethod @default(SYSTEM)
  reason String?

  actorId String? @map("actor_id") @db.Uuid
  actor   User?   @relation("LeadAssignmentActor", fields: [actorId], references: [id])

  assignedAt DateTime @default(now()) @map("assigned_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([leadId, assignedAt])
  @@index([assignedToId])
  @@map("lead_assignments")
}

/// Structured CRM follow-up — not a free-text LeadNote.
model LeadFollowUp {
  id String @id @default(uuid()) @db.Uuid

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  outcome    String?
  note       String?
  followUpAt DateTime? @map("follow_up_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([leadId, createdAt])
  @@index([followUpAt])
  @@map("lead_follow_ups")
}

/// One effective automatic policy per scope. Manual assignment is an action, not a policy.
model LeadDistributionPolicy {
  id String @id @default(uuid()) @db.Uuid

  mode     LeadDistributionMode
  isActive Boolean              @default(true) @map("is_active")
  startedAt DateTime            @default(now()) @map("started_at")
  expiresAt DateTime?           @map("expires_at")

  scopeType    LeadDistributionScope @default(COMPANY) @map("scope_type")
  teamId       String?               @map("team_id") @db.Uuid
  team         SalesTeam?            @relation(fields: [teamId], references: [id])
  departmentId String?               @map("department_id") @db.Uuid
  department   Department?           @relation(fields: [departmentId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  state LeadDistributionState?

  @@index([isActive, scopeType, expiresAt])
  @@map("lead_distribution_policies")
}

/// Persistent Round Robin cursor — locked FOR UPDATE during assignment.
model LeadDistributionState {
  id String @id @default(uuid()) @db.Uuid

  policyId String                 @unique @map("policy_id") @db.Uuid
  policy   LeadDistributionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  lastAssignedEmployeeId String? @map("last_assigned_employee_id") @db.Uuid
  cursorPosition         Int     @default(0) @map("cursor_position")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("lead_distribution_states")
}

/// System-generated timeline. `type` is a plain string, not an enum — the
/// task described examples (Lead Created, Lead Assigned, Lead Status
/// Changed, Note Added), not a closed set, so new entry types can appear
/// later without a migration. This timeline will later become Order History.
model LeadActivity {
  id String @id @default(uuid()) @db.Uuid

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("lead_activities")
}

model LeadNote {
  id String @id @default(uuid()) @db.Uuid

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  text String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("lead_notes")
}

// ---------------------------------------------------------------------------
// Sales Orders — Phase 2 core module. Starts only after a Lead reaches PAID.
// No Customer entity exists yet (SalesOrder.leadId is the only customer-facing
// link); no pricing calculation, inventory deduction, accounting, invoicing,
// reporting, or warehouse stock movement is implemented here — see
// docs/blueprints/sales-orders-phase1-design.md for the full design and the
// approved-decisions table it was updated with before this schema was written.
// ---------------------------------------------------------------------------

/// TASK-012 decision #3: LABEL_CREATED inserted between READY_FOR_SHIPPING and
/// SHIPPED. RETURNED may be reached from any prior stage.
enum SalesOrderStatus {
  CREATED
  READY_FOR_SHIPPING
  LABEL_CREATED
  SHIPPED
  DELIVERED
  RETURNED
}

/// Closed set, exactly as approved — who pays for shipping cost.
enum ShippingCostPayer {
  CUSTOMER
  COMPANY
}

/// TASK-012 decision #2 (Shipment stores its own Status) + decision #6
/// (returns distinguish before/after delivery). This is per-shipment-attempt
/// state, distinct from the order-level SalesOrderStatus.
enum ShipmentStatus {
  LABEL_CREATED
  SHIPPED
  DELIVERED
  RETURN_BEFORE_DELIVERY
  RETURN_AFTER_DELIVERY

  /// Store Orders shipping pipeline only (see StoreOrder model comment) —
  /// additive values, never used by the legacy SalesOrder shipment flow
  /// above, which keeps using the five original values unchanged.
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  NEEDS_RESHIPMENT
}

model SalesOrder {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @map("order_number")

  leadId String @map("lead_id") @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id])

  /// Snapshot fields — copied from the Lead at creation, never updated
  /// afterward (decision #13). Currency is copied the same way by extension.
  customerName String @map("customer_name")
  mobileNumber String @map("mobile_number")

  countryId String  @map("country_id") @db.Uuid
  country   Country @relation(fields: [countryId], references: [id])

  city    String
  address String

  currencyId String   @map("currency_id") @db.Uuid
  currency   Currency @relation(fields: [currencyId], references: [id])

  costCenterId String     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id])

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])

  /// Mandatory — decision #6.
  paymentMethodId String        @map("payment_method_id") @db.Uuid
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  /// Mandatory — decision #7.
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  /// Snapshot of the Lead's sales employee at creation time. Stored
  /// separately from shippingEmployeeId — decision #8.
  salesEmployeeId String? @map("sales_employee_id") @db.Uuid
  salesEmployee   User?   @relation("SalesOrderSalesEmployee", fields: [salesEmployeeId], references: [id])

  /// Assigned later via the "Assign Shipping Employee" operation.
  shippingEmployeeId String? @map("shipping_employee_id") @db.Uuid
  shippingEmployee   User?   @relation("SalesOrderShippingEmployee", fields: [shippingEmployeeId], references: [id])

  /// TASK-012 decision #4: operational users, each a real FK to User (unlike
  /// the generic unenforced createdBy/updatedBy audit columns below). No
  /// auth exists, so all four are nullable and client-supplied wherever set.
  /// createdById is distinct from the generic audit `created_by` column —
  /// this one is a proper relation because it has explicit business meaning
  /// here (who operationally created the order), not just an audit trail.
  createdById   String? @map("created_by_id") @db.Uuid
  createdByUser User?   @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])

  /// Snapshotted from the Lead's verified Payment at order-creation time, if
  /// one exists (Payment Verification module).
  paymentVerifiedById   String? @map("payment_verified_by_id") @db.Uuid
  paymentVerifiedByUser User?   @relation("SalesOrderPaymentVerifiedBy", fields: [paymentVerifiedById], references: [id])

  /// No operation sets this yet in this phase — schema-only, see ADR-0008.
  packedById   String? @map("packed_by_id") @db.Uuid
  packedByUser User?   @relation("SalesOrderPackedBy", fields: [packedById], references: [id])

  /// No operation sets this yet in this phase — schema-only, see ADR-0008.
  handedToShippingById   String? @map("handed_to_shipping_by_id") @db.Uuid
  handedToShippingByUser User?   @relation("SalesOrderHandedToShippingBy", fields: [handedToShippingById], references: [id])

  status SalesOrderStatus @default(CREATED)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  items         OrderItem[]
  shipments     Shipment[]
  attachments   SalesOrderAttachment[]
  notes         SalesOrderNote[]
  activities    SalesOrderActivity[]
  statusHistory SalesOrderStatusHistory[]

  @@map("sales_orders")
}

/// Pricing snapshot per line item (decision #5) — future product price
/// changes must never affect existing orders, so nothing here is derived
/// from a live Product price (no Product entity exists yet anyway).
/// TASK-012 decision #1: SalesOrder -> OrderItem -> Product (placeholder),
/// Product is never linked directly to SalesOrder. Renamed from
/// SalesOrderItem to match this exact architecture vocabulary.
model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

  /// No Product entity/module exists yet — same placeholder pattern as
  /// Lead.productId, intentionally not a foreign key.
  productId String? @map("product_id") @db.Uuid

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  offer     String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("order_items")
}

/// One shipping attempt — independent entity (TASK-012 decision #2), never
/// storing tracking number (or anything else shipment-specific) on
/// SalesOrder itself. Reshipping creates a new row here against the same
/// SalesOrder (decision #15/#5: unlimited attempts, #1/#2/#3...) rather than
/// overwriting this one — that's what keeps every shipment's tracking/cost/
/// label/notes history intact permanently.
model Shipment {
  id String @id @default(uuid()) @db.Uuid

  /// Nullable — a Shipment now belongs to exactly one of SalesOrder (legacy
  /// Leads-COD pipeline) or StoreOrder (see StoreOrder model comment), never
  /// both. Made optional (was required) so the same table serves both
  /// pipelines instead of forking a second Shipment concept.
  salesOrderId String?     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])

  storeOrderId String?     @map("store_order_id") @db.Uuid
  storeOrder   StoreOrder? @relation(fields: [storeOrderId], references: [id])

  /// 1, 2, 3... per order — decision #5's explicit "#1 / #2 / #3" numbering.
  attemptNumber Int @map("attempt_number")

  /// Reference Data, never free text — decision #2.
  shippingCompanyId String?          @map("shipping_company_id") @db.Uuid
  shippingCompany   ShippingCompany? @relation(fields: [shippingCompanyId], references: [id])

  /// Dynamic catalog row for display / Google Sheets. Kept in sync with
  /// `status` for seeded operational codes; custom administrator statuses
  /// are stored here even when they have no ShipmentStatus enum value.
  shippingStatusId String?         @map("shipping_status_id") @db.Uuid
  shippingStatus   ShippingStatus? @relation(fields: [shippingStatusId], references: [id])

  trackingNumber String? @map("tracking_number")

  /// Set by the "Upload Shipping Label" operation — decision #2: Shipment
  /// stores the label itself, not only a generic tagged attachment (though
  /// an attachment is still created too, preserving full history).
  labelUrl String? @map("label_url")

  /// Per-shipment-attempt state — decision #2. Null until the shipment
  /// progresses to LABEL_CREATED.
  status ShipmentStatus?

  /// Decision #11.
  baseShippingCost       Decimal?           @map("base_shipping_cost") @db.Decimal(12, 2)
  additionalShippingCost Decimal?           @map("additional_shipping_cost") @db.Decimal(12, 2)
  costPaidBy             ShippingCostPayer? @map("cost_paid_by")

  /// Decision #2: Shipment stores Notes. A plain field, not an unlimited
  /// collection — unlike SalesOrderNote/PaymentNote, no "unlimited" wording
  /// was used for this one.
  notes String?

  isReship Boolean @default(false) @map("is_reship")

  /// Data Synchronization (Google Sheets / CSV shipping updates) conflict
  /// detection — stamped only by `ShippingUpdatesImportHandler` right after
  /// it successfully applies a change, never by the manual UI or bulk
  /// actions. If `updatedAt` is later than this the next time an import/
  /// sync run reaches this shipment, some OTHER channel touched it since,
  /// so the row is flagged `NEEDS_REVIEW` instead of silently overwritten
  /// — see that handler's own doc comment for the exact check.
  lastExternalSyncAt DateTime? @map("last_external_sync_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  attachments SalesOrderAttachment[]

  @@index([storeOrderId])
  @@index([salesOrderId])
  @@index([status, createdAt])
  @@index([shippingCompanyId])
  @@index([deletedAt, createdAt])
  @@map("shipments")
}

/// Unlimited attachments (decision #10), including the shipping label image —
/// tagged via attachmentType and linked to a Shipment, not a dedicated column.
model SalesOrderAttachment {
  id String @id @default(uuid()) @db.Uuid

  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

  shipmentId String?   @map("shipment_id") @db.Uuid
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])

  /// Required — "every attachment stores... uploader" (decision #10). No
  /// auth exists, so the client supplies this explicitly, same precedent as
  /// LeadNote.userId.
  uploadedById String @map("uploaded_by_id") @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  fileUrl        String  @map("file_url")
  fileName       String? @map("file_name")
  /// Plain string, not an enum — e.g. "SHIPPING_LABEL", "GENERAL". Left open
  /// the same way LeadActivity.type is, since more types may appear later.
  attachmentType String  @map("attachment_type")
  description    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([salesOrderId])
  @@map("sales_order_attachments")
}

/// Append-only in this phase — create + list only, no update/delete
/// operation was in the required list.
model SalesOrderNote {
  id String @id @default(uuid()) @db.Uuid

  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  text String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([salesOrderId])
  @@map("sales_order_notes")
}

/// General timeline — decision #9: "Timeline is not Status History." Plain
/// string type (not an enum), same reasoning as LeadActivity: the examples
/// given are illustrative, not an exhaustive closed set.
model SalesOrderActivity {
  id String @id @default(uuid()) @db.Uuid

  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([salesOrderId])
  @@map("sales_order_activities")
}

/// Decision #1: dedicated, append-only status log. Deliberately omits
/// updated_at/updated_by/deleted_at — present on every other table per
/// ADR-0002, but their existence here would contradict "never update, never
/// delete." Enforced by the application never calling update/delete on this
/// table (no such service methods exist), not by a DB-level trigger.
model SalesOrderStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  salesOrderId String     @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

  fromStatus SalesOrderStatus? @map("from_status")
  toStatus   SalesOrderStatus  @map("to_status")

  changedAt DateTime @default(now()) @map("changed_at")
  changedBy String?  @map("changed_by") @db.Uuid

  @@map("sales_order_status_history")
}

// ---------------------------------------------------------------------------
// Payment Verification — Phase 1. Confirms a customer's payment before a Lead
// becomes PAID and a Sales Order can be created. Payment.leadId is optional
// (a payment can be recorded before it's matched to any lead); Customer and
// Sales Order links are explicitly future work — not modeled here at all
// (not even as nullable placeholders), since neither exists as a concrete
// need yet at the point a Payment is verified.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  MATCHED
  VERIFIED
  REJECTED
}

/// Reference Data — "PAYMENT SOURCES... Reference Data only." Distinct from
/// the existing generic PaymentMethod entity (Reference Data Engine,
/// ADR-0003), which was seeded with nothing and has no concrete meaning yet;
/// this one is seeded with the exact given values.
/// Minimal ledger-account reference list only — NOT an accounting engine.
/// No posting, no journal entries, no balances live here (explicitly out of
/// scope). This exists purely so PaymentSource.defaultChartOfAccountId and
/// ReceivingAccount.chartOfAccountId (required) have a valid, real FK
/// target — "the accounting entry MUST ultimately use the Receiving
/// Account's ChartOfAccount," but no accounting entry is created by OMS.
/// TASK-044 Part 6 — the 5 fundamental accounting classifications. A closed
/// set (same treatment as ProductType/FinancialTransactionType), not a
/// free-text classifier, because Journal Entry balance/reporting logic will
/// eventually need to switch on it.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartOfAccount {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  /// TASK-044 Part 6 — required: no rows existed yet when this was added
  /// (unlike PaymentSource.code), so no nullable-for-backfill compromise
  /// was needed.
  accountType AccountType @map("account_type")

  /// Account Hierarchy (TASK-044 Part 6, same prepared-only pattern as
  /// Warehouse.parentWarehouseId / AnalyticAccount.parentAccountId): a real
  /// self-relation FK, no depth limit. TASK-053 adds real cycle prevention
  /// in ChartOfAccountsService (walks the full ancestor chain, not just the
  /// immediate self-parent check that existed before) — no traversal API.
  parentAccountId String?          @map("parent_account_id") @db.Uuid
  parentAccount   ChartOfAccount?  @relation("ChartOfAccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   ChartOfAccount[] @relation("ChartOfAccountHierarchy")

  /// TASK-053 — an account can be locked to one currency (e.g. a USD bank
  /// account); null means it follows whatever currency each posting uses,
  /// same as before this task. `allowReconciliation` marks an account as a
  /// matching/reconciliation candidate (AR/AP/Bank) — prepared for a future
  /// reconciliation feature, same "flag exists, no engine consumes it yet"
  /// pattern as `Product.defaultCostMethod` (ADR-0012).
  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  allowReconciliation Boolean @default(false) @map("allow_reconciliation")

  /// Unified Partner Architecture — server-set (never user-editable)
  /// whenever this account is wired as PostingSettings.accountsReceivable/
  /// PayableAccountId or a CustomerProfile/CustomerGroup/SupplierProfile/
  /// SupplierGroup default-account override. Lets the Posting Engine and
  /// Journal Entries service cheaply answer "does a line against this
  /// account require a partnerId" without hardcoding account ids.
  partnerControlType PartnerControlAccountType? @map("partner_control_type")

  /// Denormalized hierarchy depth (root = 1, set from `parentAccount.level +
  /// 1` on create) — avoids an ancestor walk just to indent/group the tree.
  level Int @default(1)

  /// A header/parent account stops accepting direct journal postings the
  /// moment it gets its first child (leaf-only posting model, Part 13) —
  /// flipped to `false` server-side in the same transaction that creates
  /// that first child, never set directly by a client. `JournalEntry` line
  /// resolution rejects any line whose account has this `false`.
  allowsPosting Boolean @default(true) @map("allows_posting")

  /// Safe Account Deletion (2026-08-15) — the canonical, stable flag for
  /// the 5 permanently-protected top-level categories (codes 1-5: Assets/
  /// Liabilities/Equity/Revenue/Expenses). Set once, server-side, by
  /// `ChartOfAccountsService.create()` when a NEW root account (no parent)
  /// is created with one of those 5 codes — never inferred from name/code
  /// anywhere else, never settable via Update. `archive()` rejects outright
  /// whenever this is true, regardless of usage.
  isSystemAccount Boolean @default(false) @map("is_system_account")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  paymentSourcesDefault PaymentSource[]
  receivingAccounts     ReceivingAccount[]
  journalEntryLines     JournalEntryLine[]

  /// Cash Flow module — accounts used as a direct Expense debit target.
  financialTransactionsExpense FinancialTransaction[] @relation("FinancialTransactionExpenseAccount")
  bankTransactionsExpense      BankTransaction[]      @relation("BankTransactionExpenseAccount")

  /// Transaction Types Registry — a type's configured default posting account.
  transactionTypesDefault TransactionType[] @relation("TransactionTypeDefaultAccount")

  /// Google Sheets Readiness — every Payment Method's required linked
  /// accounting account (spec section 5).
  paymentMethods PaymentMethod[] @relation("PaymentMethodAccount")

  /// TASK-046 (Accounting Posting Engine) — every role a Chart of Account
  /// can play for the Posting Engine's default/fallback account resolution.
  customerProfilesDefaultReceivable CustomerProfile[] @relation("CustomerProfileDefaultReceivable")
  supplierProfilesDefaultPayable    SupplierProfile[] @relation("SupplierProfileDefaultPayable")
  supplierProfilesDefaultExpense    SupplierProfile[] @relation("SupplierProfileDefaultExpense")
  taxOutputFor                      Tax[]             @relation("TaxOutputAccount")
  taxInputFor                       Tax[]             @relation("TaxInputAccount")

  postingSettingsSalesRevenue        PostingSettings[] @relation("PostingSalesRevenue")
  postingSettingsCogs                PostingSettings[] @relation("PostingCogs")
  postingSettingsInventory           PostingSettings[] @relation("PostingInventory")
  postingSettingsAr                  PostingSettings[] @relation("PostingAr")
  postingSettingsAp                  PostingSettings[] @relation("PostingAp")
  postingSettingsExpense             PostingSettings[] @relation("PostingExpense")
  postingSettingsSalesDiscount       PostingSettings[] @relation("PostingSalesDiscount")
  postingSettingsSalesReturn         PostingSettings[] @relation("PostingSalesReturn")
  postingSettingsInventoryAdjustment PostingSettings[] @relation("PostingInventoryAdjustment")
  postingSettingsPurchase            PostingSettings[] @relation("PostingPurchase")
  postingSettingsPurchaseReturn      PostingSettings[] @relation("PostingPurchaseReturn")
  postingSettingsCash                PostingSettings[] @relation("PostingCash")
  postingSettingsBank                PostingSettings[] @relation("PostingBank")
  postingSettingsVatOutput           PostingSettings[] @relation("PostingVatOutput")
  postingSettingsVatInput            PostingSettings[] @relation("PostingVatInput")
  postingSettingsRoundDifference     PostingSettings[] @relation("PostingRoundDifference")
  postingSettingsPurchaseDiscount    PostingSettings[] @relation("PostingPurchaseDiscount")
  postingSettingsExchangeDifference  PostingSettings[] @relation("PostingExchangeDifference")
  postingSettingsSuspense            PostingSettings[] @relation("PostingSuspense")
  postingSettingsRetainedEarnings    PostingSettings[] @relation("PostingRetainedEarnings")

  /// TASK-047 — Product Category / Customer Group / Supplier Group
  /// account-mapping overrides.
  categoriesDefaultRevenue   ProductCategory[] @relation("CategoryRevenueAccount")
  categoriesDefaultInventory ProductCategory[] @relation("CategoryInventoryAccount")
  categoriesDefaultCogs      ProductCategory[] @relation("CategoryCogsAccount")
  categoriesDefaultPurchase  ProductCategory[] @relation("CategoryPurchaseAccount")
  customerGroupsReceivable   CustomerGroup[]   @relation("CustomerGroupDefaultReceivable")
  customerGroupsRevenue      CustomerGroup[]   @relation("CustomerGroupDefaultRevenue")
  supplierGroupsPayable      SupplierGroup[]   @relation("SupplierGroupDefaultPayable")
  supplierGroupsPurchase     SupplierGroup[]   @relation("SupplierGroupDefaultPurchase")

  /// TASK-053 — Journal default Dr/Cr account configuration.
  journalsDefaultDebit  Journal[] @relation("JournalDefaultDebit")
  journalsDefaultCredit Journal[] @relation("JournalDefaultCredit")

  @@map("chart_of_accounts")
}

enum JournalType {
  SALES
  PURCHASE
  CASH
  BANK
  GENERAL
}

/// Journal (TASK-053) — Odoo-style journal configuration: WHICH book of
/// entry an accounting document belongs to (Sales/Purchase/Cash/Bank/
/// General), each with its own default Dr/Cr accounts, currency, and
/// branch. Purely a configuration + classification entity — it does not
/// replace or rewire the Posting Engine's own numbering (every automatic
/// posting still mints its number from the single "JOURNAL_ENTRY"
/// NumberSeries, same as before this task); `sequencePrefix` is a display
/// label only. `JournalEntry.journalId` links an entry to one of these —
/// nullable so existing/automatic entries keep working unchanged, but
/// required before a manual entry can be Posted (see JournalEntriesService).
model Journal {
  id   String      @id @default(uuid()) @db.Uuid
  name String
  code String      @unique
  type JournalType

  /// Display-only prefix shown next to the journal (e.g. "SJ") — the real
  /// auto-numbering still runs through the existing NumberingEngineService.
  sequencePrefix String? @map("sequence_prefix")

  defaultDebitAccountId String?         @map("default_debit_account_id") @db.Uuid
  defaultDebitAccount   ChartOfAccount? @relation("JournalDefaultDebit", fields: [defaultDebitAccountId], references: [id])

  defaultCreditAccountId String?         @map("default_credit_account_id") @db.Uuid
  defaultCreditAccount   ChartOfAccount? @relation("JournalDefaultCredit", fields: [defaultCreditAccountId], references: [id])

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  journalEntries        JournalEntry[]
  journalEntryTemplates JournalEntryTemplate[]

  @@map("journals")
}

/// "HOW the customer paid" (Cash, Bank Transfer, Visa, MyFatoorah, ...) —
/// purely a reference-data label. No gateway credentials, API keys, URLs,
/// webhook fields, provider settings, or authentication live here or
/// anywhere else in OMS — OMS is an ERP, not a payment gateway.
model PaymentSource {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  /// Nullable: 6 rows already existed before this field was added (no
  /// backfill performed on pre-existing seed data) — new rows should set it.
  code        String?
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  /// Distinct from deletedAt/"Archive": IsActive is a separate toggle
  /// ("Deactivate") that hides a source from new use without removing it.
  isActive    Boolean @default(true) @map("is_active")
  /// The row auto-selected when an Order-mode Lead needs a PaymentSource but
  /// the user only typed a Paid Amount — falls back to the first active row
  /// (by sortOrder/name) when nothing is flagged.
  isDefault   Boolean @default(false) @map("is_default")

  /// Optional default suggestion only — never the actual accounting
  /// destination (that's always ReceivingAccount.chartOfAccountId).
  defaultChartOfAccountId String?         @map("default_chart_of_account_id") @db.Uuid
  defaultChartOfAccount   ChartOfAccount? @relation(fields: [defaultChartOfAccountId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  payments              Payment[]
  financialTransactions FinancialTransaction[]

  @@map("payment_sources")
}

/// "WHERE the money actually arrived" (Main Cashbox, Al Rajhi Main, SNB
/// Bank, STC Wallet, ...) — the real accounting destination. Distinct from
/// PaymentSource: a single ReceivingAccount can receive money from many
/// different PaymentSources (e.g. both "Visa" and "Mada" might settle into
/// the same bank account).
model ReceivingAccount {
  id   String @id @default(uuid()) @db.Uuid
  name String
  code String @unique

  /// No Company/multi-entity module exists yet — same placeholder pattern
  /// as Lead.productId / OrderItem.productId, intentionally not a foreign key.
  companyId String? @map("company_id") @db.Uuid

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  /// Required — decision: "ChartOfAccountId is REQUIRED on Receiving
  /// Account." This is the accounting destination every Payment against
  /// this account ultimately uses.
  chartOfAccountId String         @map("chart_of_account_id") @db.Uuid
  chartOfAccount   ChartOfAccount @relation(fields: [chartOfAccountId], references: [id])

  notes     String?
  isActive  Boolean @default(true) @map("is_active")
  /// Same Order-mode smart-default role as PaymentSource.isDefault.
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  payments                   Payment[]
  financialTransactions      FinancialTransaction[]
  /// Cash Flow module — the master-data "Cash Source" every imported Bank/
  /// Cash Flow transaction maps to (never a free-text bank name for a new
  /// import — see BankTransaction.cashSourceId).
  bankTransactionsCashSource BankTransaction[]      @relation("BankTransactionCashSource")

  @@map("receiving_accounts")
}

model Payment {
  id            String @id @default(uuid()) @db.Uuid
  paymentNumber String @unique @map("payment_number")

  /// Optional — a payment can exist before it's tied to any lead.
  leadId String? @map("lead_id") @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  /// Optional — parallel to leadId, for the independent Store Orders
  /// pipeline (see StoreOrder model comment). A Payment belongs to at most
  /// one of leadId/storeOrderId. Reuses this same reconciliation/bank-
  /// matching engine untouched — it has no source filtering today.
  storeOrderId String?     @map("store_order_id") @db.Uuid
  storeOrder   StoreOrder? @relation(fields: [storeOrderId], references: [id])

  paymentDate  DateTime  @map("payment_date")
  receivedDate DateTime? @map("received_date")

  amount Decimal @db.Decimal(12, 2)

  currencyId String   @map("currency_id") @db.Uuid
  currency   Currency @relation(fields: [currencyId], references: [id])

  /// PaymentSourceId answers "how did the customer pay?" — required alongside
  /// ReceivingAccountId ("where did the money arrive?"), never only one.
  paymentSourceId String        @map("payment_source_id") @db.Uuid
  paymentSource   PaymentSource @relation(fields: [paymentSourceId], references: [id])

  receivingAccountId String           @map("receiving_account_id") @db.Uuid
  receivingAccount   ReceivingAccount @relation(fields: [receivingAccountId], references: [id])

  referenceNumber String? @map("reference_number")
  senderName      String  @map("sender_name")
  bankAccount     String? @map("bank_account")

  status PaymentStatus @default(PENDING)

  matchedAt   DateTime? @map("matched_at")
  matchedById String?   @map("matched_by_id") @db.Uuid
  matchedBy   User?     @relation("PaymentMatchedBy", fields: [matchedById], references: [id])

  verifiedAt   DateTime? @map("verified_at")
  verifiedById String?   @map("verified_by_id") @db.Uuid
  verifiedBy   User?     @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])

  rejectedAt      DateTime? @map("rejected_at")
  rejectedById    String?   @map("rejected_by_id") @db.Uuid
  rejectedBy      User?     @relation("PaymentRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  attachments PaymentAttachment[]
  notes       PaymentNote[]
  activities  PaymentActivity[]
  receipts    StoreOrderReceipt[]

  reconciledBankTransactions BankTransaction[]

  @@index([storeOrderId])
  @@index([leadId])
  @@index([status])
  @@map("payments")
}

/// Bank Statement import + reconciliation (Part 10), extended into the Cash
/// Flow module — step one of Bank Transaction -> Find Matching Order/
/// Invoice -> Match/Reconcile -> Update Status -> Create reconciliation
/// record. Never auto-confirms a match — `PaymentAutoMatchingService` /
/// `CashFlowReconciliationService` only classify/score candidates; a human
/// always performs the actual "Confirm Match" write, reusing the existing
/// `PaymentsService.match()` (Store Orders) / `FinancialTransactionsService
/// .confirm()` (B2B, Supplier Payment, Expense) business operations rather
/// than a second, parallel matching or posting mechanism.
enum BankTransactionMatchStatus {
  UNMATCHED
  /// Shown to the user as "Suggested" — a scored candidate exists but
  /// hasn't been confirmed.
  POTENTIAL
  /// This transaction's amount was allocated across matched documents but
  /// not fully consumed (e.g. a receipt partially allocated to invoices).
  PARTIALLY_MATCHED
  MATCHED
  /// Import-time duplicate (same fingerprint/external id already exists).
  DUPLICATE
  /// The already-reconciled/posted transaction changed materially on a
  /// later re-sync (amount/currency/date) — never silently re-posted.
  CONFLICT
  /// Ambiguous (tied candidates, or a conflict) — routed to a human, never
  /// auto-resolved.
  MANUAL_REVIEW
}

enum CashFlowDirection {
  INCOMING
  OUTGOING
}

/// Outgoing-only classification (spec: "NOT every cash movement is a bank
/// reconciliation... Incoming and outgoing transactions have different
/// accounting/business workflows"). Extensible — adding a value here later
/// is a closed-set addition, never a second transaction table.
enum CashFlowOutgoingType {
  SUPPLIER_PAYMENT
  EXPENSE
}

model BankTransaction {
  id String @id @default(uuid()) @db.Uuid

  /// The source's own External Transaction ID. For a manually-uploaded raw
  /// bank statement this often stays empty (many exports have none) and
  /// `fingerprint` (below) remains the dedup identity; for a Cash Flow
  /// Google Sheets sync row this is REQUIRED (enforced in
  /// `BankTransactionsImportHandler`, not at the DB level, since the two
  /// channels have different guarantees) and — together with `cashSourceId`
  /// — is THE idempotency key: `@@unique([cashSourceId, transactionId])`
  /// below. Scoped per cash source, not globally, since two different
  /// banks/providers can legitimately reuse the same transaction id scheme.
  transactionId String? @map("transaction_id")

  transactionDate DateTime  @map("transaction_date")
  valueDate       DateTime? @map("value_date")

  account     String?
  reference   String?
  description String?

  /// Raw debit/credit as the source file had them (banks differ on whether
  /// they use two columns or one signed column) — `amount` (below) is
  /// always the one normalized, signed value every matching/reporting query
  /// actually reads.
  debit  Decimal? @db.Decimal(12, 2)
  credit Decimal? @db.Decimal(12, 2)
  amount Decimal  @db.Decimal(12, 2)

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  balance  Decimal? @db.Decimal(12, 2)
  /// Raw source label, display-only — never the accounting mapping (that's
  /// always `cashSourceId` below, once mapped).
  bankName String?  @map("bank_name")
  branch   String?
  notes    String?

  /// Deterministic hash of date+amount+reference+description+account+
  /// currency — the stable business identity for a row from a source with
  /// no `transactionId`. If the same row moves from row 500 to row 600 on a
  /// re-import, this is still the same value, so re-importing a statement
  /// never creates a duplicate row (upserted by this, not by row position).
  fingerprint String @unique

  /// Incoming vs Outgoing (Cash Flow spec section 1) — set once at import
  /// time from the sync source's configured direction (or the sign of
  /// `amount` for a manual upload), never recomputed afterward so it can't
  /// drift if a correction changes the sign.
  direction CashFlowDirection?

  /// The Chart-of-Accounts-backed master-data "Cash Source" this row's raw
  /// `bankName`/`account` text was mapped to (spec section 3 — "never a
  /// free-text account name where the system already has a master-data
  /// record"). Reuses `ReceivingAccount` — already "the real accounting
  /// destination" master-data entity — rather than inventing a parallel
  /// CashSource entity.
  cashSourceId String?           @map("cash_source_id") @db.Uuid
  cashSource   ReceivingAccount? @relation("BankTransactionCashSource", fields: [cashSourceId], references: [id])

  /// Outgoing-only classification hint, usually supplied by the source
  /// sheet's own "Transaction Type" column — drives which reconciliation
  /// path (Purchase Invoice vs Payment Voucher) a human is offered.
  outgoingType CashFlowOutgoingType? @map("outgoing_type")

  /// Outgoing + EXPENSE only — the expense account an auto-generated
  /// Payment Voucher (FinancialTransaction/EXPENSE_PAYMENT) should debit.
  expenseAccountId String?         @map("expense_account_id") @db.Uuid
  expenseAccount   ChartOfAccount? @relation("BankTransactionExpenseAccount", fields: [expenseAccountId], references: [id])

  /// Outgoing + SUPPLIER_PAYMENT only — a classification hint from the
  /// source row (e.g. a "Partner" column), never itself the reconciliation
  /// (that's `matchedFinancialTransactionId`).
  partnerId String?  @map("partner_id") @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  matchStatus     BankTransactionMatchStatus @default(UNMATCHED) @map("match_status")
  /// Authoritative Matching StatusDefinition — kept in sync with `matchStatus`.
  matchStatusId String?           @map("match_status_id") @db.Uuid
  matchStatusDef StatusDefinition? @relation("BankTransactionMatchStatusDef", fields: [matchStatusId], references: [id])
  /// The scored candidate list from the last `PaymentAutoMatchingService` /
  /// `CashFlowReconciliationService` classification pass — display-only,
  /// recomputed on every matching run, never hand-edited.
  matchCandidates Json?                      @map("match_candidates")
  /// Human-readable reason for CONFLICT/MANUAL_REVIEW — e.g. "amount
  /// changed from 500.00 to 520.00 after this row was already reconciled".
  conflictReason  String?                    @map("conflict_reason")

  /// Incoming, Store Order path — reuses the existing `Payment`/
  /// `PaymentsService.match()`/`StoreOrderPaymentSyncService` machinery
  /// untouched (see model doc comment).
  matchedPaymentId String?  @map("matched_payment_id") @db.Uuid
  matchedPayment   Payment? @relation(fields: [matchedPaymentId], references: [id])

  /// Incoming B2B / Outgoing Supplier Payment / Outgoing Expense paths —
  /// the `FinancialTransaction` (Customer Receipt / Supplier Payment /
  /// Expense Payment Voucher) this row was reconciled to or generated,
  /// reusing `FinancialTransactionsService`/the Posting Engine untouched.
  /// Checked before creating a new one on re-sync — the idempotency
  /// guarantee for this reconciliation path.
  matchedFinancialTransactionId String?               @map("matched_financial_transaction_id") @db.Uuid
  matchedFinancialTransaction   FinancialTransaction? @relation(fields: [matchedFinancialTransactionId], references: [id])

  matchedAt   DateTime? @map("matched_at")
  matchedById String?   @map("matched_by_id") @db.Uuid
  matchedBy   User?     @relation("BankTransactionMatchedBy", fields: [matchedById], references: [id])

  /// Which sync/import run created this row (Data Synchronization — Cash
  /// Flow) — set only on first insert, never overwritten on a later
  /// re-sync upsert, so it always points at the original source run.
  /// Null for a manually-uploaded bank statement (no sync run involved).
  importJobId String?    @map("import_job_id") @db.Uuid
  importJob   ImportJob? @relation(fields: [importJobId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  /// Idempotency for a Cash-Flow-synced row (spec section 4) — scoped per
  /// cash source since two different banks/providers can share the same
  /// external id scheme; both nullable, so legacy/manual rows with neither
  /// set are simply excluded from this guarantee (Postgres treats every
  /// NULL as distinct), same as before this migration.
  @@unique([cashSourceId, transactionId])
  @@index([direction, matchStatus])
  @@index([matchStatusId])
  @@map("bank_transactions")
}

/// Canonical reusable file object. Bytes live in object storage — never in
/// PostgreSQL. Staging rows (`finalizedAt` null) expire and are cleaned up
/// if conversion/payment linking does not complete.
model Attachment {
  id String @id @default(uuid()) @db.Uuid

  fileName        String @map("file_name")
  originalName    String @map("original_name")
  mimeType        String @map("mime_type")
  sizeBytes       Int    @map("size_bytes")
  storageProvider String @map("storage_provider")
  storageKey      String @unique @map("storage_key")
  checksum        String?

  uploadedById String @map("uploaded_by_id") @db.Uuid
  uploadedBy   User   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  createdAt      DateTime  @default(now()) @map("created_at")
  finalizedAt    DateTime? @map("finalized_at")
  expiresAt      DateTime? @map("expires_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedById    String?   @map("deleted_by_id") @db.Uuid
  deletedBy      User?     @relation("AttachmentDeletedBy", fields: [deletedById], references: [id])
  deletionReason String?   @map("deletion_reason")

  paymentLinks       PaymentAttachment[]
  storeOrderReceipts StoreOrderReceipt[]

  @@index([uploadedById])
  @@index([deletedAt, finalizedAt])
  @@map("attachments")
}

/// Payment ↔ Attachment join. `fileUrl` remains for legacy URL-only proof
/// (`attachmentId` null). New uploads always set `attachmentId`.
model PaymentAttachment {
  id String @id @default(uuid()) @db.Uuid

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id])

  attachmentId String?     @unique @map("attachment_id") @db.Uuid
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])

  uploadedById String @map("uploaded_by_id") @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  fileUrl        String  @map("file_url")
  fileName       String? @map("file_name")
  attachmentType String  @map("attachment_type")
  description    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([paymentId, deletedAt])
  @@map("payment_attachments")
}

/// Unlimited internal notes — same shape as SalesOrderNote (create + list only).
model PaymentNote {
  id String @id @default(uuid()) @db.Uuid

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  text String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("payment_notes")
}

/// General timeline (Payment Created, Matched, Verified, Rejected, Attachment
/// Added, Note Added, ...) — plain string type, same reasoning as
/// LeadActivity/SalesOrderActivity: examples given, not a closed set. No
/// separate append-only "status history" table was requested for Payment
/// (unlike SalesOrder's decision #1), so this single timeline covers status
/// changes too.
model PaymentActivity {
  id String @id @default(uuid()) @db.Uuid

  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("payment_activities")
}

// ---------------------------------------------------------------------------
// Product Engine — Foundation. A flexible product model every future module
// (Inventory, Pricing, Ecommerce, Shipping, ...) will depend on. No inventory
// quantities, stock movement, cost, selling/purchase price, accounting, tax,
// warehouse balance, or ecommerce fields live here — those are explicitly
// future phases. Bundle *behavior* is not implemented — BUNDLE exists only as
// a ProductType value.
// ---------------------------------------------------------------------------

/// Closed set (TASK-027) — replaces the earlier PHYSICAL/SERVICE/DIGITAL/
/// BUNDLE set (never seeded, no production data, safe rename). STOCKABLE is
/// tracked in inventory; CONSUMABLE is purchased/used but not precisely
/// stock-tracked; SERVICE has no physical form.
/// Product Operation Type (TASK-028) — replaces the earlier STOCKABLE/
/// SERVICE/CONSUMABLE set with business-oriented types that drive which
/// tabs/fields the UI shows.
/// "Business Behavior" (TASK-028, Inventory Foundation pass) — KIT renamed
/// to MANUFACTURED (Prisma enum-value rename, existing rows keep their
/// data) and SALES_ONLY added: sellable, not purchased through this
/// system, still inventory-tracked (distinct from SERVICE, which has no
/// physical form at all). MANUFACTURED is "sold as one item, built from
/// child products (BOM)" — the BOM itself lives on `ProductComponent`;
/// automatic inventory deduction on sale is NOT implemented here (it would
/// mean changing SalesOrders' fulfillment logic, a separate module this
/// task doesn't touch) — the architecture is prepared, not wired.
/// EXPENSE_ITEM predates this behavior list and isn't one of its five named
/// values, but nothing asked for its removal and it may already have data
/// — kept as a sixth, additional value rather than deleted.
enum ProductType {
  PURCHASE_ONLY
  SALES_ONLY
  PURCHASE_AND_SALE
  MANUFACTURED
  SERVICE
  EXPENSE_ITEM
}

/// Costing Method (TASK-028 Part 2) — closed set, exactly as specified.
/// Architecture only, same as `InventoryValuationMethod` (TASK-030): no
/// FIFO/Standard-variance calculation engine reads this yet.
enum ProductCostingMethod {
  AVERAGE
  FIFO
  STANDARD
}

/// Closed set. DRAFT added for the Draft-first creation flow (TASK-028
/// already lets Create ask for only name/type/category/unit — DRAFT makes
/// that incompleteness visible instead of silently marking a
/// not-yet-operational product ACTIVE) — ACTIVE/INACTIVE stay as specified.
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Product {
  id   String @id @default(uuid()) @db.Uuid
  /// Arabic name — the primary identity field (Arabic is the default locale
  /// throughout OMS); unchanged column from ADR-0011's `name`.
  name String

  /// English name (TASK-027) — optional, additive to `name`.
  nameEn String? @map("name_en")

  /// Identity (ADR-0012) — both required. internalName is the operational/
  /// back-office name; displayName is customer-facing. Additive to `name`
  /// (ADR-0011): this task adds fields, it doesn't rename or remove one.
  internalName String @map("internal_name")
  displayName  String @map("display_name")

  /// "Product Code" / "SKU" (TASK-027) — one auto-generated identifier
  /// serving both roles (never typed by a user), minted via the Numbering
  /// Engine's PRODUCT series. Must be unique.
  sku String @unique

  barcode     String?
  /// QR payload (TASK-027) — independent of barcode; a business may encode a
  /// different value (URL, JSON) in its QR label than its barcode.
  qrCodeValue String? @map("qr_code_value")

  /// Free-text search aid (ADR-0012) — optional, not a tag/category system.
  searchKeywords String? @map("search_keywords")

  /// Internal-only notes (TASK-027) — never shown to customers, distinct
  /// from `description`/`shortDescription`/`longDescription`.
  internalNotes String? @map("internal_notes")

  /// Simple text-tag list (TASK-027) — no separate Tag entity; lightweight,
  /// matches `searchKeywords`'s "no tag/category system" precedent above.
  tags String[] @default([])

  /// Relations (ADR-0012): Category and Unit are now required; Brand stays
  /// optional, exactly as specified. Reference-data architecture
  /// (ProductCategory/ProductBrand/Unit) itself is untouched.
  categoryId String          @map("category_id") @db.Uuid
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  brandId String?       @map("brand_id") @db.Uuid
  brand   ProductBrand? @relation(fields: [brandId], references: [id])

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id])

  /// Classification (TASK-027) — Tax Group, Cost Center (an Analytic
  /// Account, per the existing Analytic Accounting foundation), and
  /// Preferred Supplier. All optional: a product may exist before any of
  /// these are decided.
  taxId String? @map("tax_id") @db.Uuid
  tax   Tax?    @relation(fields: [taxId], references: [id])

  analyticAccountId String?          @map("analytic_account_id") @db.Uuid
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])

  preferredPartnerId String?  @map("preferred_partner_id") @db.Uuid
  preferredPartner   Partner? @relation(fields: [preferredPartnerId], references: [id])

  description String?

  /// Descriptions (ADR-0012) — both optional, additive to `description`.
  shortDescription String? @map("short_description")
  longDescription  String? @map("long_description")

  type   ProductType
  status ProductStatus @default(ACTIVE)

  imageUrl String? @map("image_url")

  /// Product Flags (ADR-0012, retyped for TASK-027) — type-based defaults
  /// computed in ProductsService (STOCKABLE: all true; SERVICE:
  /// purchasable=false/sellable=true/inventoryItem=false; CONSUMABLE:
  /// purchasable=true/sellable=false/inventoryItem=false), manual override
  /// always allowed. Doubles as "Available For Purchase" / "Available For
  /// Sale" / "Track Inventory" (TASK-027) — no separate columns for the
  /// same three booleans.
  isPurchasable   Boolean @map("is_purchasable")
  isSellable      Boolean @map("is_sellable")
  isInventoryItem Boolean @map("is_inventory_item")

  /// Sales section (TASK-027).
  salesPrice       Decimal? @map("sales_price") @db.Decimal(12, 2)
  salesTaxIncluded Boolean  @default(false) @map("sales_tax_included")
  salesDescription String?  @map("sales_description")
  allowDiscount    Boolean  @default(true) @map("allow_discount")

  /// Purchasing section (TASK-027). `preferredSupplierId` is declared above
  /// with the other Classification relations.
  purchasePrice       Decimal? @map("purchase_price") @db.Decimal(12, 2)
  purchaseDescription String?  @map("purchase_description")

  /// Inventory section (TASK-027) — `isInventoryItem` above doubles as
  /// "Track Inventory". `reorderLevel` is the reorder POINT (the on-hand
  /// threshold that triggers reordering); `reorderQuantity` (TASK-028) is
  /// the separate "how much to reorder" amount, and `safetyStock` is the
  /// buffer floor kept on top of forecast demand — three distinct planning
  /// numbers, not one field wearing three names.
  reorderLevel         Decimal? @map("reorder_level") @db.Decimal(12, 3)
  reorderQuantity      Decimal? @map("reorder_quantity") @db.Decimal(12, 3)
  safetyStock          Decimal? @map("safety_stock") @db.Decimal(12, 3)
  minQuantity          Decimal? @map("min_quantity") @db.Decimal(12, 3)
  maxQuantity          Decimal? @map("max_quantity") @db.Decimal(12, 3)
  storageLocation      String?  @map("storage_location")
  serialNumberTracking Boolean  @default(false) @map("serial_number_tracking")
  batchTracking        Boolean  @default(false) @map("batch_tracking")

  /// Dimensions — nullable at the DB level; "mandatory when isInventoryItem
  /// is true" (ADR-0012) is enforced in ProductsService, since it's
  /// conditional on another column and Postgres NOT NULL can't express that
  /// without a CHECK constraint this task didn't ask for.
  weight Decimal? @db.Decimal(12, 3)
  width  Decimal? @db.Decimal(12, 3)
  height Decimal? @db.Decimal(12, 3)
  length Decimal? @db.Decimal(12, 3)

  /// TASK-028 — the two ADR-0012 "future placeholders" become real,
  /// wired fields: a genuine FK to Warehouse (Preferred Warehouse) and a
  /// closed-set Costing Method, both settable via the Product form/API now.
  /// `defaultTaxCategory` stays an untyped placeholder — no closed set was
  /// given for it and this task didn't touch tax categorization.
  preferredWarehouseId String?               @map("preferred_warehouse_id") @db.Uuid
  preferredWarehouse   Warehouse?            @relation(fields: [preferredWarehouseId], references: [id])
  costingMethod        ProductCostingMethod? @map("costing_method")
  defaultTaxCategory   String?               @map("default_tax_category")

  /// Cost Engine Foundation (ADR-0014) — denormalized mirror of the current
  /// ProductCostSnapshot for fast reads without a join. `costingMethod`
  /// above (TASK-028) is the one and only "cost method" field — not a
  /// second column parallel to it.
  currentCost    Decimal?  @map("current_cost") @db.Decimal(12, 2)
  lastCostUpdate DateTime? @map("last_cost_update")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  activities         ProductActivity[]
  inventoryMovements InventoryMovement[]
  costHistory        ProductCostHistory[]
  costSnapshot       ProductCostSnapshot?
  purchaseOrderItems PurchaseOrderItem[]
  variants           ProductVariant[]
  attachments        ProductAttachment[]
  /// BOM lines where this product is the finished Kit.
  components         ProductComponent[]   @relation("KitComponents")
  /// BOM lines where this product is used AS a component of some Kit.
  usedInKits         ProductComponent[]   @relation("ComponentUsedIn")
  physicalCountLines PhysicalCountLine[]

  salesQuotationItems     SalesQuotationItem[]
  salesOrderDocumentItems SalesOrderDocumentItem[]
  salesInvoiceItems       SalesInvoiceItem[]
  salesReturnItems        SalesReturnItem[]
  purchaseQuotationItems  PurchaseQuotationItem[]
  purchaseInvoiceItems    PurchaseInvoiceItem[]
  purchaseReturnItems     PurchaseReturnItem[]
  leads                   Lead[]
  storeOrderItems         StoreOrderItem[]

  @@index([deletedAt, createdAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

/// Kit Bill of Materials (TASK-028) — one row per (Kit, component) pair.
/// Deliberately just the composition list: quantity of each component per
/// one unit of the Kit. No automatic inventory deduction on sale is wired
/// here (see the ProductType enum comment) — this is the data a future
/// Sales fulfillment step would explode against, not a working deduction
/// engine yet.
model ProductComponent {
  id String @id @default(uuid()) @db.Uuid

  kitProductId String  @map("kit_product_id") @db.Uuid
  kitProduct   Product @relation("KitComponents", fields: [kitProductId], references: [id])

  componentProductId String  @map("component_product_id") @db.Uuid
  componentProduct   Product @relation("ComponentUsedIn", fields: [componentProductId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kitProductId, componentProductId])
  @@map("product_components")
}

/// Product Variants (TASK-027) — generic attribute bag (`attributes` as
/// JSON, e.g. `{"color":"Red","size":"L"}`) rather than a full attribute/
/// value/combination-matrix engine: enough to represent "this SKU is the
/// Red/L version of that product" and list/manage it, without building an
/// automatic combination generator nothing asked for yet.
model ProductVariant {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  /// Same Numbering Engine series as the parent product — never typed by hand.
  sku             String   @unique
  attributes      Json
  priceAdjustment Decimal? @map("price_adjustment") @db.Decimal(12, 2)
  active          Boolean  @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("product_variants")
}

/// Product Attachments (TASK-027) — same url-based, metadata-only shape as
/// `PaymentAttachment`/`SalesOrderAttachment`: no file-upload backend exists
/// anywhere in this codebase yet, so this stores a caller-supplied URL, not
/// file bytes.
model ProductAttachment {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  uploadedById String @map("uploaded_by_id") @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  fileUrl     String  @map("file_url")
  fileName    String? @map("file_name")
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("product_attachments")
}

/// General timeline ("Log every business operation") — plain string type,
/// same reasoning as every other *Activity entity in this codebase (Lead,
/// SalesOrder, Payment): CRUD operations here are Create/Update/Delete, not
/// a closed set of named business operations, so a fixed enum would be the
/// wrong shape.
model ProductActivity {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("product_activities")
}

// ---------------------------------------------------------------------------
// Inventory Engine — Foundation (ADR-0013). Movement-based: stock quantity is
// never stored or edited directly on Product/Warehouse — every change is an
// InventoryMovement row, and current on-hand quantity is derived by summing
// movements for a given product+warehouse. No costing, pricing, accounting,
// tax, purchasing, manufacturing, or ecommerce logic lives here — those are
// future, separately-scoped modules. ASSEMBLY/DISASSEMBLY/PRODUCTION exist
// only as movement-type values — no Bundle/Manufacturing logic implemented,
// same treatment as ProductType.BUNDLE in ADR-0011.
// ---------------------------------------------------------------------------

/// Closed set. TASK-030 added the six purchasing/sales/production document
/// types as master-data vocabulary (matching this codebase's existing
/// pattern of representing a closed reference list as an enum, e.g.
/// LeadStatus/ShippingMethodType, rather than a parallel DB table) — no
/// Purchasing/Sales/Manufacturing module writes these yet (those stay
/// "must never create inventory movements" per ADR-0015 until their own
/// fulfillment phases exist); the values only complete the vocabulary this
/// engine's future callers will use.
enum InventoryMovementType {
  OPENING_BALANCE
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RESERVATION_RELEASE
  DAMAGE
  EXPIRED
  ASSEMBLY
  DISASSEMBLY
  PRODUCTION
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  SALES_DELIVERY
  SALES_RETURN
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  /// TASK-029 — the adjustment a confirmed Physical Count generates for a
  /// counted/system quantity difference. A distinct type (not a reuse of
  /// ADJUSTMENT) so the Stock Movement History can tell a manual adjustment
  /// apart from a count-driven one at a glance.
  PHYSICAL_COUNT
}

/// Append-only ledger — no updatedAt/updatedBy/deletedAt (ADR-0013). Movement
/// history must never be edited or deleted: doing so would corrupt every
/// later quantityBefore/quantityAfter snapshot for the same product+warehouse.
/// Same exception already used for SalesOrderStatusHistory (ADR-0007).
model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid

  /// App-generated ("MV-000001", ...) via inventory_movement_number_seq —
  /// not a Prisma-managed default, same pattern as Lead/SalesOrder/Payment
  /// numbers.
  movementNumber String @unique @map("movement_number")

  type InventoryMovementType

  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  /// Signed delta. For OPENING_BALANCE/ADJUSTMENT/TRANSFER/DAMAGE/EXPIRED/
  /// ASSEMBLY/DISASSEMBLY/PRODUCTION this changes on-hand quantity. For
  /// RESERVATION/RESERVATION_RELEASE this is a separate reserved-ledger
  /// delta and does NOT change quantityBefore/quantityAfter (ADR-0013) —
  /// reservations don't move physical stock in this foundation.
  quantity Int

  /// On-hand quantity snapshot (product+warehouse), not the reserved ledger.
  quantityBefore Int @map("quantity_before")
  quantityAfter  Int @map("quantity_after")

  /// Free-form link to whatever business document caused this movement
  /// (e.g. a future Sales Order, Purchase Order, or this movement's own
  /// TRANSFER counterpart) — no FK, since most of those modules don't exist
  /// yet.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid

  /// Caller-supplied unit cost at the time of this movement (TASK-028 Stock
  /// Movements) — nullable, since most movement types (Adjustment/
  /// Transfer/Damage) don't carry a cost. Never calculated here — the same
  /// "store what's given, compute nothing" rule as ProductCostService.
  unitCost Decimal? @map("unit_cost") @db.Decimal(12, 2)

  /// TASK-029 — required on Adjustment ("Reason" field), also set on the
  /// movements a confirmed Physical Count generates. Nullable at the DB
  /// level since most movement types never carry one; DTO-level validation
  /// enforces "required" for the types that need it.
  reason String?

  notes String?

  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by") @db.Uuid
  createdByUser User?    @relation(fields: [createdBy], references: [id])

  activities InventoryMovementActivity[]

  /// Reverse side of PhysicalCountLine.movement — the count line(s) this
  /// movement was generated for (normally at most one).
  physicalCountLines PhysicalCountLine[]

  @@map("inventory_movements")
}

/// Timeline — same shape as every other *Activity entity in this codebase.
model InventoryMovementActivity {
  id String @id @default(uuid()) @db.Uuid

  inventoryMovementId String            @map("inventory_movement_id") @db.Uuid
  inventoryMovement   InventoryMovement @relation(fields: [inventoryMovementId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("inventory_movement_activities")
}

/// TASK-029 — Physical Inventory Count. DRAFT while counted quantities are
/// being entered; CONFIRMED once the differences have generated their
/// PHYSICAL_COUNT movements (irreversible, same posture as every other
/// append-only inventory operation); CANCELLED if abandoned before confirm.
enum PhysicalCountStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// A counting document for one Warehouse — one or more lines snapshot the
/// system on-hand quantity at creation time; the user enters what they
/// physically counted; confirming generates one PHYSICAL_COUNT movement per
/// line with a real difference (ADR-0013: never edits stock directly).
model PhysicalCount {
  id String @id @default(uuid()) @db.Uuid

  /// App-generated ("CNT-2026-000001") via the Numbering Engine.
  countNumber String @unique @map("count_number")

  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status PhysicalCountStatus @default(DRAFT)
  notes  String?

  confirmedAt DateTime? @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  lines PhysicalCountLine[]

  @@map("physical_counts")
}

/// One product's counted line within a PhysicalCount. `systemQuantity` is a
/// frozen snapshot (never recalculated after creation, so the comparison
/// stays meaningful even if other movements happen mid-count);
/// `countedQuantity` is null until the user enters it; `movementId` links to
/// the PHYSICAL_COUNT movement generated for this line on confirm (null if
/// the count matched exactly — no movement needed for a zero difference).
model PhysicalCountLine {
  id String @id @default(uuid()) @db.Uuid

  physicalCountId String        @map("physical_count_id") @db.Uuid
  physicalCount   PhysicalCount @relation(fields: [physicalCountId], references: [id])

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  systemQuantity  Int  @map("system_quantity")
  countedQuantity Int? @map("counted_quantity")

  movementId String?            @map("movement_id") @db.Uuid
  movement   InventoryMovement? @relation(fields: [movementId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([physicalCountId, productId])
  @@map("physical_count_lines")
}

/// Closed set, exactly as specified (TASK-030 section 7 — "Architecture
/// only"). No FIFO/Average calculation engine reads this yet; it exists so
/// the system-level setting has a real value to hold.
enum InventoryValuationMethod {
  AVERAGE_COST
  FIFO
}

/// System-wide setting, not per-product — singleton row (fixed id) rather
/// than a full settings table, since exactly one value exists company-wide
/// today. `InventoryService.getOrCreateValuationSettings()` creates this row
/// with the default on first read rather than requiring a migration-time
/// seed.
model InventorySettings {
  id Int @id @default(1)

  valuationMethod InventoryValuationMethod @default(AVERAGE_COST) @map("valuation_method")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("inventory_settings")
}

// ---------------------------------------------------------------------------
// Cost Engine — Foundation (ADR-0014). Prepares the architecture that a future
// Purchasing module will drive: no FIFO/LIFO/Average calculation, no cost
// allocation/distribution logic, no inventory valuation, no accounting journal
// entries live here. CostAllocationRule exists as schema/enum only — "No
// calculation yet. Only architecture" — no service/controller was built for
// it in this task.
// ---------------------------------------------------------------------------

model CostComponent {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  activities      CostComponentActivity[]
  allocationRules CostAllocationRule[]

  @@map("cost_components")
}

/// Timeline — same shape as every other *Activity entity in this codebase.
model CostComponentActivity {
  id String @id @default(uuid()) @db.Uuid

  costComponentId String        @map("cost_component_id") @db.Uuid
  costComponent   CostComponent @relation(fields: [costComponentId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("cost_component_activities")
}

/// Closed set, exactly as specified. No calculation logic anywhere reads
/// this yet — schema/architecture only, for a future Purchasing/allocation
/// task to build against.
enum CostAllocationMethod {
  BY_QUANTITY
  BY_COST
  EQUAL
  MANUAL
}

/// Schema only — no DTO/service/controller in this task ("No calculation
/// yet. Only architecture"), unlike CostComponent which the task explicitly
/// gave business-operation endpoints for.
model CostAllocationRule {
  id     String               @id @default(uuid()) @db.Uuid
  name   String
  method CostAllocationMethod

  costComponentId String?        @map("cost_component_id") @db.Uuid
  costComponent   CostComponent? @relation(fields: [costComponentId], references: [id])

  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("cost_allocation_rules")
}

/// Append-only — "Never overwrite history." Same reasoning as
/// InventoryMovement (ADR-0013): no updatedAt/updatedBy/deletedAt.
model ProductCostHistory {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  /// Null on the very first cost ever recorded for a product (no prior value existed).
  previousCost Decimal? @map("previous_cost") @db.Decimal(12, 2)
  newCost      Decimal  @map("new_cost") @db.Decimal(12, 2)

  reason String?

  /// Free-form link to whatever caused this change (e.g. a future Purchase
  /// Order) — no FK, since Purchasing doesn't exist yet.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@map("product_cost_histories")
}

/// "Maintain current product cost. One active snapshot per product." —
/// enforced via the unique productId: this row is updated in place when cost
/// changes (unlike ProductCostHistory, which never overwrites). "No manual
/// editing endpoint" — only ProductCostService writes to this table.
model ProductCostSnapshot {
  id String @id @default(uuid()) @db.Uuid

  productId String  @unique @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  cost Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("product_cost_snapshots")
}

// ---------------------------------------------------------------------------
// Purchasing — Phase 1 (ADR-0015): Suppliers + Purchase Orders. "Purchase
// Order is only an agreement to buy" — it never touches Inventory, Product
// Cost, Accounting, or Stock. No Goods Receipt, Purchase Invoice, Supplier
// Payments, Cost Allocation, Accounting, Inventory Transactions, or Tax logic
// lives here — those are future, separately-scoped phases.
// ---------------------------------------------------------------------------

/// Closed set, exactly as specified.
// ---------------------------------------------------------------------------
// Unified Partner Architecture — Partner is the single canonical
// counterparty identity across OMS (replaces the formerly separate
// Customer/Supplier tables — physical merge, foundation-stage decision, no
// compatibility layer). Identity (who this entity is) lives on Partner;
// role-specific configuration (how OMS can interact with them) lives on the
// optional *Profile tables. A Partner may hold multiple roles at once (e.g.
// CUSTOMER + SUPPLIER) via PartnerRoleAssignment — never a duplicated
// identity per role. Accounting stays control-account based: no GL account
// is ever created per Partner (see ChartOfAccount.partnerControlType +
// PostingSettings.accountsReceivableAccountId/accountsPayableAccountId) —
// Partner only supplies the subledger dimension on JournalEntryLine.
// ---------------------------------------------------------------------------

enum PartnerEntityType {
  PERSON
  ORGANIZATION
}

/// Closed set, exactly as specified.
enum PartnerStatus {
  ACTIVE
  INACTIVE
}

/// A Partner may hold more than one of these at once — see
/// PartnerRoleAssignment. EMPLOYEE/OWNER are net-new roles (no prior model
/// existed for either); OTHER is the open-ended bucket for a counterparty
/// that is none of the above (e.g. a government/tax authority).
enum PartnerRoleType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  OWNER
  OTHER
}

/// Which control-account role a Chart of Account plays, server-set (never
/// user-editable) whenever the account is wired as
/// PostingSettings.accountsReceivableAccountId/accountsPayableAccountId or a
/// CustomerProfile/CustomerGroup/SupplierProfile/SupplierGroup default
/// override. The Posting Engine and Journal Entries service use this to
/// answer "does this line's account require a partnerId" without hardcoding
/// account ids.
enum PartnerControlAccountType {
  RECEIVABLE
  PAYABLE
}

/// Where this Partner record originated. Only MANUAL and LEAD_CONVERSION are
/// actually produced by this codebase's code today — the channel
/// integrations themselves (Website/Salla/API/Google Sheets) are a future,
/// separate scope; this field is the extensibility point they plug into
/// later. (Formerly `CustomerSource` — renamed since it is identity-origin,
/// not role-specific.)
enum PartnerSource {
  MANUAL
  WEBSITE
  SALLA
  API
  IMPORT
  GOOGLE_SHEETS
  LEAD_CONVERSION
  OTHER
}

model Partner {
  id String @id @default(uuid()) @db.Uuid

  /// App-generated ("PT-2026-000001") via the Numbering Engine — never
  /// user-typed (spec: "user should not manually manage technical IDs").
  partnerNumber String @unique @map("partner_number")

  name           String
  legalName      String? @map("legal_name")
  commercialName String? @map("commercial_name")

  entityType PartnerEntityType @default(ORGANIZATION) @map("entity_type")

  phone   String?
  mobile  String?
  email   String?
  website String?

  taxNumber              String? @map("tax_number")
  commercialRegistration String? @map("commercial_registration")

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  countryId String?  @map("country_id") @db.Uuid
  country   Country? @relation(fields: [countryId], references: [id])

  /// No City reference-data entity exists — plain text, same as every other
  /// ad hoc address field in this codebase.
  city    String?
  address String?
  notes   String?

  status PartnerStatus @default(ACTIVE)
  source PartnerSource @default(MANUAL)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  roles           PartnerRoleAssignment[]
  customerProfile CustomerProfile?
  supplierProfile SupplierProfile?
  employeeProfile EmployeeProfile?

  leads                 Lead[]
  storeOrders           StoreOrder[]
  salesQuotations       SalesQuotation[]
  salesOrders           SalesOrderDocument[]
  salesInvoices         SalesInvoice[]
  salesReturns          SalesReturn[]
  purchaseOrders        PurchaseOrder[]
  purchaseQuotations    PurchaseQuotation[]
  purchaseInvoices      PurchaseInvoice[]
  purchaseReturns       PurchaseReturn[]
  preferredForProducts  Product[]
  financialTransactions FinancialTransaction[]
  journalEntryLines     JournalEntryLine[]
  /// Cash Flow module — outgoing transactions the sync/import row hinted are
  /// this partner (classification only, before a Supplier Payment Voucher
  /// is created).
  bankTransactionsHint  BankTransaction[]

  /// Dedup lookup (spec section 14: phone/email/tax number/CR) that
  /// PartnersService.create() runs on every write — same indexing rationale
  /// the former CustomersService.create() used.
  @@index([phone])
  @@index([email])
  @@index([taxNumber])
  @@index([deletedAt, name])
  @@map("partners")
}

/// One row per role a Partner holds. `@@unique([partnerId, role])` is what
/// makes "assign SUPPLIER to an existing CUSTOMER Partner" idempotent —
/// re-assigning an already-held role is rejected, never silently duplicated.
model PartnerRoleAssignment {
  id String @id @default(uuid()) @db.Uuid

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id])

  role PartnerRoleType

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([partnerId, role])
  @@map("partner_role_assignments")
}

/// CUSTOMER-role configuration only — identity fields stay on Partner.
model CustomerProfile {
  id String @id @default(uuid()) @db.Uuid

  partnerId String  @unique @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id])

  customerGroupId String?        @map("customer_group_id") @db.Uuid
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])

  paymentTermId String?      @map("payment_term_id") @db.Uuid
  paymentTerm   PaymentTerm? @relation(fields: [paymentTermId], references: [id])

  creditLimit Decimal? @map("credit_limit") @db.Decimal(12, 2)

  /// Posting Engine's SalesInvoicePostingProvider / CustomerReceipt provider
  /// read this as the Accounts Receivable account for this partner, falling
  /// back to PostingSettings.accountsReceivableAccountId.
  defaultReceivableAccountId String?         @map("default_receivable_account_id") @db.Uuid
  defaultReceivableAccount   ChartOfAccount? @relation("CustomerProfileDefaultReceivable", fields: [defaultReceivableAccountId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

/// SUPPLIER-role configuration only — identity fields stay on Partner.
model SupplierProfile {
  id String @id @default(uuid()) @db.Uuid

  partnerId String  @unique @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id])

  supplierGroupId String?        @map("supplier_group_id") @db.Uuid
  supplierGroup   SupplierGroup? @relation(fields: [supplierGroupId], references: [id])

  /// No closed set of values was specified — free-text (same reasoning as
  /// Product.defaultCostMethod, ADR-0012).
  paymentTerm String?  @map("payment_term")
  creditLimit Decimal? @map("credit_limit") @db.Decimal(12, 2)
  isPreferred Boolean  @default(false) @map("is_preferred")

  /// Posting Engine's PurchaseInvoicePostingProvider reads this as the
  /// Accounts Payable account, falling back to
  /// PostingSettings.accountsPayableAccountId.
  defaultPayableAccountId String?         @map("default_payable_account_id") @db.Uuid
  defaultPayableAccount   ChartOfAccount? @relation("SupplierProfileDefaultPayable", fields: [defaultPayableAccountId], references: [id])

  /// The expense account used for non-inventory-tracked Purchase Invoice
  /// lines (services), falling back to PostingSettings.defaultExpenseAccountId.
  defaultExpenseAccountId String?         @map("default_expense_account_id") @db.Uuid
  defaultExpenseAccount   ChartOfAccount? @relation("SupplierProfileDefaultExpense", fields: [defaultExpenseAccountId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("supplier_profiles")
}

/// EMPLOYEE-role configuration — genuinely new (no HR module exists in this
/// codebase). Kept minimal per the architecture decision: Partner supplies
/// the financial identity, this supplies the HR-adjacent link only. `userId`
/// is optional — an Employee Partner used only for advances/expense
/// reimbursement need not have a system login.
model EmployeeProfile {
  id String @id @default(uuid()) @db.Uuid

  partnerId String  @unique @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id])

  userId String? @unique @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  jobTitleId String?   @map("job_title_id") @db.Uuid
  jobTitle   JobTitle? @relation(fields: [jobTitleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_profiles")
}

// ---------------------------------------------------------------------------
// Store Orders + Shipping Operations — an independent order pipeline for
// storefront/marketplace orders (manual entry + Excel/Sheets import). Never
// a Lead, never routed through Lead -> SalesOrder. Reuses existing
// infrastructure by extension rather than duplication: Payment gained
// storeOrderId (bank-matching/reconciliation engine untouched), Shipment
// gained storeOrderId (reshipment-on-failure/attempt-history logic
// untouched), SalesInvoice gained storeOrderId (Posting Engine untouched).
// externalOrderId is the unique import identity; phone is only ever the
// Customer matching key (via the existing CustomersService.findOrCreate),
// never the Order key — re-importing the same externalOrderId must always
// be rejected as a duplicate of the existing internalOrderId, never create
// a second Order.
// ---------------------------------------------------------------------------

enum StoreOrderSource {
  MANUAL
  IMPORT
  EXCEL
  GOOGLE_SHEETS
}

enum StoreOrderPaymentStatus {
  PAYMENT_PENDING
  PARTIALLY_PAID
  FULLY_PAID_RECONCILED
  OVERPAID
  UNMATCHED
  PAYMENT_REVIEW
}

/// Fixed system catalog — not master data. How the order is expected to be
/// paid, distinct from `paymentStatus` (Finance/Reconciliation) and from
/// shipping status. Do not add values without a new decision.
enum StoreOrderPaymentType {
  PREPAID
  CASH_ON_DELIVERY
}

/// Order-level shipping gate before any Shipment row exists. Once a
/// Shipment is created, the order's effective shipping state is read from
/// its current (latest, non-superseded) Shipment.status instead — this enum
/// only covers the pre-shipment stage, not the full 7-state lifecycle
/// (that lifecycle lives on ShipmentStatus).
enum StoreOrderShippingStage {
  NOT_READY
  READY_FOR_SHIPPING
}

model StoreOrder {
  id String @id @default(uuid()) @db.Uuid

  /// App-generated via the Numbering Engine ("STORE_ORDER" key) — never
  /// user-typed, same pattern as Partner.partnerNumber.
  internalOrderId String @unique @map("internal_order_id")

  /// The source system's own order id (e.g. a marketplace order number).
  /// THE unique import identity — re-importing the same value is rejected
  /// as a duplicate of the existing internalOrderId, never a new Order.
  /// Null for manually-created orders (internalOrderId alone identifies
  /// those).
  externalOrderId String? @unique @map("external_order_id")

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id])

  /// Optional — set when StoreOrder originates from Lead conversion. Unique so
  /// a Lead converts to at most one Store Order (idempotent conversion gate).
  leadId String? @unique @map("lead_id") @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  orderDate DateTime @default(now()) @map("order_date")

  source        StoreOrderSource @default(MANUAL)
  sourceChannel String?          @map("source_channel")

  employeeId String? @map("employee_id") @db.Uuid
  employee   User?   @relation("StoreOrderEmployee", fields: [employeeId], references: [id])

  paymentStatus StoreOrderPaymentStatus @default(PAYMENT_PENDING) @map("payment_status")
  /// Authoritative Payment StatusDefinition — dual-written with `paymentStatus`.
  paymentStatusId String?           @map("payment_status_id") @db.Uuid
  paymentStatusDef StatusDefinition? @relation("StoreOrderPaymentStatusDef", fields: [paymentStatusId], references: [id])
  /// Fixed catalog (PREPAID / CASH_ON_DELIVERY) — not financial confirmation.
  paymentType   StoreOrderPaymentType   @default(PREPAID) @map("payment_type")
  shippingStage StoreOrderShippingStage @default(NOT_READY) @map("shipping_stage")
  /// Authoritative Fulfillment StatusDefinition — dual-written with `shippingStage`
  /// (and advanced by shipment events). ShippingStatus on Shipment remains the
  /// carrier-attempt catalog (sync behavior) — not a second order identity.
  fulfillmentStatusId String?           @map("fulfillment_status_id") @db.Uuid
  fulfillmentStatus   StatusDefinition? @relation("StoreOrderFulfillmentStatusDef", fields: [fulfillmentStatusId], references: [id])

  currencyId String   @map("currency_id") @db.Uuid
  currency   Currency @relation(fields: [currencyId], references: [id])

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  items      StoreOrderItem[]
  receipts   StoreOrderReceipt[]
  activities StoreOrderActivity[]
  payments   Payment[]
  shipments  Shipment[]
  invoices   SalesInvoice[]

  @@index([partnerId])
  /// `externalOrderId String? @unique` above already creates this index —
  /// a second explicit `@@index([externalOrderId])` was a pure duplicate
  /// (same lookup, extra write cost on every import) and was removed here.
  @@index([deletedAt, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([paymentStatusId])
  @@index([shippingStage, createdAt])
  @@index([fulfillmentStatusId])
  @@index([orderDate])
  @@index([employeeId])
  @@map("store_orders")
}

/// Pricing snapshot per line — same rationale as the legacy OrderItem model
/// above: future Product price changes must never affect an existing order.
model StoreOrderItem {
  id String @id @default(uuid()) @db.Uuid

  storeOrderId String     @map("store_order_id") @db.Uuid
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id])

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  /// Agreed selling amount for this line — independent of quantity.
  /// Totals use this field; `unitPrice` is retained as a derived snapshot
  /// (agreedAmount / quantity) so legacy qty×unit readers stay approximately equal.
  agreedAmount Decimal @map("agreed_amount") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("store_order_items")
}

/// Order attachments: uploaded files (storageKey set) or legacy URL-only
/// rows (fileUrl is an external URL, storageKey is null). driveFileId/
/// driveFileUrl remain unused placeholders.
model StoreOrderReceipt {
  id String @id @default(uuid()) @db.Uuid

  storeOrderId String     @map("store_order_id") @db.Uuid
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id])

  paymentId String?  @map("payment_id") @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id])

  fileUrl       String  @map("file_url")
  fileName      String? @map("file_name")
  mimeType      String? @map("mime_type")
  fileSizeBytes Int?    @map("file_size_bytes")
  storageKey    String? @map("storage_key")

  attachmentId String?     @map("attachment_id") @db.Uuid
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])

  driveFileId  String? @map("drive_file_id")
  driveFileUrl String? @map("drive_file_url")

  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([paymentId])
  @@index([attachmentId])
  @@map("store_order_receipts")
}

/// Append-only audit trail — never updated or deleted, same convention as
/// InventoryMovement (ADR-0013).
/// Which channel produced a `StoreOrderActivity` entry — MANUAL is the
/// default (every pre-existing row and every controller call site that
/// hasn't been updated to pass one explicitly still lands here), BULK is
/// the Shipping screen's bulk-update action, IMPORT is a manual CSV/Excel
/// upload through Import Center, GOOGLE_SHEETS is the Data Synchronization
/// channel. Never used to gate business rules — only for the audit trail.
enum StoreOrderActivitySource {
  MANUAL
  BULK
  IMPORT
  GOOGLE_SHEETS
}

model StoreOrderActivity {
  id String @id @default(uuid()) @db.Uuid

  storeOrderId String     @map("store_order_id") @db.Uuid
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id])

  action  String
  details String?

  /// Section 28 (Data Synchronization) — "record the source of the
  /// change." Defaults MANUAL, including for every historical row (their
  /// true origin isn't recoverable; MANUAL is the least-wrong default).
  source StoreOrderActivitySource @default(MANUAL)

  performedById String? @map("performed_by_id") @db.Uuid
  performedBy   User?   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("store_order_activities")
}

// ---------------------------------------------------------------------------
// Sales Foundation (TASK-037) — the B2B document pipeline: Quotation → Sales
// Order → Invoice → Return. Mirrors the Purchasing module's proven shape
// (PurchaseOrder/PurchaseOrderItem/PurchaseOrderActivity) field-for-field
// wherever the concepts overlap. Named `SalesOrderDocument` (not
// `SalesOrder`) specifically to avoid colliding with the existing, unrelated
// `SalesOrder` model above (the Leads→Shipping COD fulfillment order, which
// already owns the Numbering Engine's `SALES_ORDER` key) — that model is not
// touched by this task. No accounting entries are created by any status
// transition here — `postedToAccounting`/`accountingPostedAt` are prep-only
// placeholders for TASK-039, exactly like Supplier's default account
// columns were prepared without implementation in ADR-0015.
// ---------------------------------------------------------------------------

/// Shared status vocabulary across all four Sales documents — each document
/// type uses its own valid subset/transition graph (enforced in each
/// service's own `transition()` helper, mirroring
/// PurchaseOrdersService.transition()), not every status applies to every
/// document (e.g. PARTIALLY_DELIVERED/DELIVERED are Sales Order-only).
enum SalesDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  CLOSED
}

model SalesQuotation {
  id              String @id @default(uuid()) @db.Uuid
  quotationNumber String @unique @map("quotation_number")

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id])

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  /// TASK-051 Document Context Enrichment — nullable, ambient (resolved from
  /// the request's active-company header, same as JournalEntry's own
  /// companyId/branchId): never required on create, never breaks an
  /// existing caller that doesn't send one.
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  /// TASK-040 — an editable business date, independent of `createdAt`
  /// (which stays the immutable system timestamp). Defaults to "now" so
  /// every pre-existing row backfills cleanly.
  documentDate DateTime @default(now()) @map("document_date")

  referenceNumber String? @map("reference_number")
  internalNotes   String? @map("internal_notes")
  customerNotes   String? @map("customer_notes")

  status SalesDocumentStatus @default(DRAFT)

  /// Server-computed from `items` on every create/update — never trusted
  /// from the client (deliberate deviation from PurchaseOrderItem.subtotal,
  /// which is caller-supplied: these are customer-facing financial
  /// documents feeding future Accounting, so totals must be internally
  /// consistent, not merely "recorded").
  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal    Decimal @default(0) @map("grand_total") @db.Decimal(12, 2)

  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  items       SalesQuotationItem[]
  activities  SalesQuotationActivity[]
  salesOrders SalesOrderDocument[]

  @@map("sales_quotations")
}

model SalesQuotationItem {
  id String @id @default(uuid()) @db.Uuid

  salesQuotationId String         @map("sales_quotation_id") @db.Uuid
  salesQuotation   SalesQuotation @relation(fields: [salesQuotationId], references: [id])

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  description String?

  /// Optional here (unlike the other three documents) — a quotation commits
  /// nothing, so forcing a warehouse choice at quote time would fight the
  /// UX policy's "minimize clicks, hide unnecessary fields."
  warehouseId String?    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id])

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountValue   Decimal @default(0) @map("discount_value") @db.Decimal(12, 2)

  taxId String? @map("tax_id") @db.Uuid
  tax   Tax?    @relation(fields: [taxId], references: [id])

  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("sales_quotation_items")
}

model SalesQuotationActivity {
  id String @id @default(uuid()) @db.Uuid

  salesQuotationId String         @map("sales_quotation_id") @db.Uuid
  salesQuotation   SalesQuotation @relation(fields: [salesQuotationId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("sales_quotation_activities")
}

/// The new B2B Sales Order document — see the module-level comment above for
/// why this is not named `SalesOrder`.
model SalesOrderDocument {
  id          String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @map("order_number")

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id])

  quotationId String?         @map("quotation_id") @db.Uuid
  quotation   SalesQuotation? @relation(fields: [quotationId], references: [id])

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  /// TASK-051 Document Context Enrichment — see SalesQuotation.companyId.
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  referenceNumber String? @map("reference_number")
  internalNotes   String? @map("internal_notes")
  customerNotes   String? @map("customer_notes")

  status SalesDocumentStatus @default(DRAFT)

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal    Decimal @default(0) @map("grand_total") @db.Decimal(12, 2)

  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  items      SalesOrderDocumentItem[]
  activities SalesOrderDocumentActivity[]
  invoices   SalesInvoice[]

  @@map("sales_order_documents")
}

model SalesOrderDocumentItem {
  id String @id @default(uuid()) @db.Uuid

  salesOrderId String             @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrderDocument @relation(fields: [salesOrderId], references: [id])

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  description String?

  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id])

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountValue   Decimal @default(0) @map("discount_value") @db.Decimal(12, 2)

  taxId String? @map("tax_id") @db.Uuid
  tax   Tax?    @relation(fields: [taxId], references: [id])

  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  /// Incremented as Sales Invoices are confirmed against this line — drives
  /// the order's Partially-Delivered/Delivered rollup. Never edited
  /// directly by a client.
  deliveredQuantity Int @default(0) @map("delivered_quantity")

  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  invoiceLines SalesInvoiceItem[]

  @@map("sales_order_document_items")
}

model SalesOrderDocumentActivity {
  id String @id @default(uuid()) @db.Uuid

  salesOrderId String             @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrderDocument @relation(fields: [salesOrderId], references: [id])

  type        String
  description String
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@map("sales_order_document_activities")
}

model SalesInvoice {
  id            String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique @map("invoice_number")

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id])

  salesOrderId String?             @map("sales_order_id") @db.Uuid
  salesOrder   SalesOrderDocument? @relation(fields: [salesOrderId], references: [id])

  /// Optional — parallel to salesOrderId, for an invoice generated from the
  /// independent Store Orders pipeline (see StoreOrder model comment).
  /// Reuses this same SalesInvoice/Posting Engine flow untouched.
  storeOrderId String?     @map("store_order_id") @db.Uuid
  storeOrder   StoreOrder? @relation(fields: [storeOrderId], references: [id])

  currencyId String?   @map("currency_id") @db.Uuid
  currency   Currency? @relation(fields: [currencyId], references: [id])

  /// TASK-051 Document Context Enrichment — see SalesQuotation.companyId.
  /// This is a posting document: costCenter/project are also carried here
  /// (unlike Quotation/Order) so they can propagate onto the Journal Entry
  /// the Posting Engine creates when this invoice is confirmed.
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  /// Snapshot at creation, never updated afterward — same "snapshot"
  /// pattern SalesOrder.customerName already uses elsewhere in this schema.
  paymentTermId String? @map("payment_term_id") @db.Uuid

  referenceNumber String? @map("reference_number")
  internalNotes   String? @map("internal_notes")
  customerNotes   String? @map("customer_notes")

  status SalesDocumentStatus @default(DRAFT)

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal    Decimal @default(0) @map("grand_total") @db.Decimal(12, 2)

  /// Prep-for-future (TASK-039) — never set true by this task's code.
  postedToAccounting Boolean   @default(false) @map("posted_to_accounting")
  accountingPostedAt DateTime? @map("accounting_posted_at")

  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at")
  cancelledBy String?   @map("cancelled_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
