# ==============================================================
# OMS API — Environment Variables
# Copy this file to .env and adjust if your local setup differs.
# Never commit the real .env file.
# ==============================================================

# --------------------------------------------------------------
# Database (Prisma) — Local PostgreSQL, started via `docker compose up -d postgres`
# --------------------------------------------------------------
DATABASE_URL="postgresql://oms:oms@localhost:5434/oms?schema=public"

# --------------------------------------------------------------
# NestJS server
# --------------------------------------------------------------
PORT=3005

# --------------------------------------------------------------
# Google Sheets import (GoogleSheetsService) — a service-account JSON key,
# either the raw JSON or base64-encoded. Create it in Google Cloud Console:
# 1. Create/select a project, enable the "Google Sheets API" and "Google
#    Drive API" (Drive is only used to read a sheet's last-modified time).
# 2. IAM & Admin -> Service Accounts -> Create Service Account -> Keys ->
#    Add Key -> JSON. Download the key file.
# 3. Share every spreadsheet this will import from with the service
#    account's own email (found in the key file as "client_email") —
#    Viewer access is enough.
# 4. Paste the key file's contents here (or base64-encode it first if your
#    env system dislikes embedded newlines/quotes: `base64 -w0 key.json`).
# Never commit the real key — this stays in .env / your host's secret
# manager only, and is never read by any frontend code.
# --------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"..."}
