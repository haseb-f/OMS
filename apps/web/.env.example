# ==============================================================
# OMS Web — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit the real .env.local file.
# ==============================================================

# Base URL of the NestJS API (apps/api). Local-first: points at the local
# backend during development; never Supabase directly.
NEXT_PUBLIC_API_URL="http://localhost:3005"

# Optional: company printed on documents/reports for users who have no company
# membership (the active company always wins). Leave empty to print a neutral
# "Company profile not set" notice. Never the product name.
NEXT_PUBLIC_PRINT_COMPANY_NAME=""
NEXT_PUBLIC_PRINT_COMPANY_LOGO_URL=""
